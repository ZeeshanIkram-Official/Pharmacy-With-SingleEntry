<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Backup &amp; Restore — Alhamd Pharmacy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .main { margin-left: 220px; }
    @media(max-width: 768px) { .main { margin-left: 60px; } }
  </style>
</head>
<body class="bg-light">

<%- include('../partials/sidebar') %>

<div class="main">
  <div class="bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm sticky-top">
    <h2 class="fs-6 fw-semibold mb-0">🗄️ Backup &amp; Restore</h2>
  </div>

  <div class="container-fluid px-4 py-3">

    <% if (success && success.length) { %>
      <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <%= success %> <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <%= error %> <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row g-3">
      <!-- ================= CREATE BACKUP ================= -->
      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h6 class="fw-bold mb-3">📥 Backup Banayein</h6>

            <table class="table table-sm mb-3">
              <tbody>
                <% Object.keys(counts).forEach(function(name) { %>
                  <tr>
                    <td><%= name %></td>
                    <td class="text-end fw-semibold"><%= counts[name] %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>

            <p class="text-muted small mb-2">
              Backup file yahan save hogi: <br><code><%= backupDir %></code>
            </p>
            <p class="text-muted small">
              ℹ️ Ye Excel file me sirf data (products, sales, customers, suppliers, payments, bank accounts, expenses,
              users waghera) save hota hai. Receipt images alag folder me hain, wo is Excel me nahi aatein.
            </p>

            <form method="POST" action="/backup/create">
              <button type="submit" class="btn btn-success btn-sm fw-semibold">⬇️ Backup Now (Excel)</button>
            </form>
          </div>
        </div>
      </div>

      <!-- ================= RESTORE ================= -->
      <div class="col-lg-6">
        <div class="card shadow-sm h-100 border-danger-subtle">
          <div class="card-body">
            <h6 class="fw-bold mb-3">📤 Restore Karein</h6>
            <div class="alert alert-warning small">
              ⚠️ <strong>Khabardar:</strong> Restore karne se current data (jis sheet ka data file me mojood hai)
              mit kar Excel file wala data dobara load ho jayega — Products, Sales, Customers, sab kuch. Ye undo
              nahi ho sakta, pehle apna current data bhi backup kar lein.
            </div>

            <form method="POST" action="/backup/restore" enctype="multipart/form-data"
                  onsubmit="return confirm('Pakka? Ye current data ko Excel file ke data se overwrite kar dega.');">
              <div class="mb-3">
                <label class="form-label small fw-semibold">Backup Excel File (.xlsx)</label>
                <input type="file" name="backupFile" accept=".xlsx" class="form-control form-control-sm" required>
              </div>
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="confirmRestore" id="confirmRestore" required>
                <label class="form-check-label small" for="confirmRestore">
                  Mujhe pata hai ye current data ko overwrite kar dega
                </label>
              </div>
              <button type="submit" class="btn btn-danger btn-sm fw-semibold">↩️ Restore From Excel</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= EXISTING BACKUPS LIST ================= -->
    <div class="card shadow-sm mt-3">
      <div class="card-body">
        <h6 class="fw-bold mb-3">🕒 Purani Backups</h6>

        <% if (files.length === 0) { %>
          <p class="text-muted small mb-0">Abhi tak koi backup nahi bani.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr>
                  <th>File Name</th>
                  <th>Size</th>
                  <th>Date/Time</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% files.forEach(function(f) { %>
                  <tr>
                    <td>📊 <%= f.name %></td>
                    <td><%= (f.size / 1024).toFixed(1) %> KB</td>
                    <td><%= new Date(f.mtime).toLocaleString() %></td>
                    <td class="text-end">
                      <a href="/backup/download/<%= encodeURIComponent(f.name) %>" class="btn btn-sm btn-outline-primary">⬇️</a>
                      <form method="POST" action="/backup/<%= encodeURIComponent(f.name) %>?_method=DELETE"
                            class="d-inline" onsubmit="return confirm('Ye backup file delete kar dein?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
