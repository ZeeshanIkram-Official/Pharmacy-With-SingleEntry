<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bank Accounts</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .main { margin-left: 220px; }
    .account-card { cursor: pointer; transition: all 0.15s; border: 2px solid #dee2e6 !important; }
    .account-card:hover { border-color: #0d6efd !important; background: #f0f6ff !important; }
    .account-card.selected { border-color: #0d6efd !important; background: #e7f1ff !important; }
    @media(max-width: 768px) { .main { margin-left: 60px; } }
  </style>
</head>
<body class="bg-light">

<%- include('../partials/sidebar') %>

<div class="main">
  <div class="bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm sticky-top">
    <h2 class="fs-6 fw-semibold mb-0">🏦 Bank Accounts</h2>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAccountModal">
      + Add Account
    </button>
  </div>

  <div class="container-fluid px-4 py-3">

    <!-- ── Date Range Filter ── -->
    <div class="bg-white border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
      <div>
        <label class="form-label small fw-semibold text-muted mb-1">📅 Date From</label>
        <input type="date" id="dateFrom" class="form-control form-control-sm" value="<%= dateFrom %>"
               style="min-width:145px;">
      </div>
      <div>
        <label class="form-label small fw-semibold text-muted mb-1">📅 Date To</label>
        <input type="date" id="dateTo" class="form-control form-control-sm" value="<%= dateTo %>"
               style="min-width:145px;">
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm fw-semibold" onclick="applyDateFilter()">🔍 Filter</button>
        <button class="btn btn-outline-secondary btn-sm" onclick="clearDateFilter()">✕ Clear</button>
      </div>
      <% if (dateFrom || dateTo) { %>
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 ms-auto">
          📅 <%= dateFrom || '...' %> — <%= dateTo || '...' %>
        </span>
      <% } %>
    </div>

    <% if (success && success.length) { %>
      <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <%= success %> <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <%= error %> <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row g-4">

      <!-- LEFT: Accounts List -->
      <div class="col-md-4">
        <h6 class="fw-semibold text-muted mb-3 text-uppercase" style="font-size:0.75rem;letter-spacing:.5px;">Accounts</h6>

        <% if (accounts.length === 0) { %>
          <div class="text-center text-muted py-5 bg-white rounded border">
            <div class="fs-2 mb-2 opacity-25">🏦</div>
            <p class="small mb-0">Koi bank account nahi. Upar se add karein.</p>
          </div>
        <% } %>

        <!-- Cash Card -->
        <div class="account-card bg-white rounded border p-3 mb-2 <%= selectedId === 'cash' ? 'selected' : '' %>">
          <a href="/bank-accounts?account=cash<%= dateFrom ? '&dateFrom=' + dateFrom : '' %><%= dateTo ? '&dateTo=' + dateTo : '' %>" class="text-decoration-none">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="fw-semibold text-dark">💵 Cash</div>
                <div class="text-muted small">Naqdh Sales + Transfers</div>
              </div>
              <div class="text-end">
                <div class="fw-bold text-success">Rs. <%= totalCash.toLocaleString() %></div>
                <div class="text-muted" style="font-size:0.7rem;">Net Balance</div>
              </div>
            </div>
          </a>
          <div class="mt-2 text-end">
            <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size:0.72rem;"
                    onclick="openTransferModal('cash', '', 'Cash')">
              ↔ Transfer
            </button>
          </div>
        </div>

        <% accounts.forEach(acc => { %>
          <div class="account-card bg-white rounded border p-3 mb-2 <%= selectedId && selectedId.toString() === acc._id.toString() ? 'selected' : '' %>">
            <a href="/bank-accounts?account=<%= acc._id %><%= dateFrom ? '&dateFrom=' + dateFrom : '' %><%= dateTo ? '&dateTo=' + dateTo : '' %>" class="text-decoration-none">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <div class="fw-semibold text-dark"><%= acc.bankName %></div>
                  <div class="text-muted small"><%= acc.accountTitle %></div>
                  <% if (acc.accountNumber) { %>
                    <div class="text-muted" style="font-size:0.72rem;letter-spacing:.3px;"><%= acc.accountNumber %></div>
                  <% } %>
                </div>
                <div class="text-end">
                  <div class="fw-bold text-success">Rs. <%= (acc.filteredBalance || 0).toLocaleString() %></div>
                  <div class="text-muted" style="font-size:0.7rem;">Net Balance</div>
                </div>
              </div>
            </a>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size:0.72rem;"
                      onclick="openTransferModal('bank', '<%= acc._id %>', '<%= acc.bankName %> — <%= acc.accountTitle %>')">
                ↔ Transfer
              </button>
              <form action="/bank-accounts/<%= acc._id %>/delete" method="POST"
                    onsubmit="return confirm('Yeh account delete karein?')">
                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size:0.72rem;">
                  🗑 Hata do
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- RIGHT: Transactions -->
      <div class="col-md-8">
        <% if (selectedId === 'cash') { %>
          <!-- ── CASH TRANSACTIONS ── -->
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-semibold text-muted mb-0 text-uppercase" style="font-size:0.75rem;letter-spacing:.5px;">
              💵 Cash — Transactions
            </h6>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
              Total: Rs. <%= totalCash.toLocaleString() %>
            </span>
          </div>

          <% if (cashSales.length === 0) { %>
            <div class="text-center text-muted py-5 bg-white rounded border">
              <div class="fs-2 mb-2 opacity-25">💵</div>
              <p class="small mb-0">Abhi koi transaction nahi.</p>
            </div>
          <% } else { %>
            <div class="bg-white rounded border overflow-hidden">
              <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="small text-muted fw-semibold py-2">Type</th>
                    <th class="small text-muted fw-semibold py-2">Detail</th>
                    <th class="small text-muted fw-semibold py-2">Amount</th>
                    <th class="small text-muted fw-semibold py-2">Date & Time</th>
                    <th class="small text-muted fw-semibold py-2"></th>
                  </tr>
                </thead>
                <tbody>
                  <% cashSales.forEach(row => { %>
                    <tr>
                      <% if (row.kind === 'sale') { %>
                        <td class="align-middle">
                          <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.68rem;">💰 Sale</span>
                        </td>
                        <td class="small text-dark align-middle">
                          <span class="fw-semibold text-primary"><%= row.invoiceNumber %></span> — <%= row.customerName %>
                        </td>
                        <td class="small fw-bold text-success align-middle">+ Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'credit-payment') { %>
                        <td class="align-middle">
                          <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size:0.68rem;">💳 Credit Payment</span>
                        </td>
                        <td class="small text-dark align-middle">
                          <span class="fw-semibold text-primary"><%= row.invoiceNumber %></span> — <%= row.customerName %>
                        </td>
                        <td class="small fw-bold text-success align-middle">+ Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'transfer-in') { %>
                        <td class="align-middle">
                          <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.68rem;">⬇ Transfer In</span>
                        </td>
                        <td class="small text-dark align-middle">From: <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %></td>
                        <td class="small fw-bold text-success align-middle">+ Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'expense') { %>
                        <td class="align-middle">
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.68rem;">💸 Expense</span>
                        </td>
                        <td class="small text-dark align-middle text-capitalize">
                          <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %>
                        </td>
                        <td class="small fw-bold text-danger align-middle">− Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'refund') { %>
                        <td class="align-middle">
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.68rem;">↩️ Refund</span>
                        </td>
                        <td class="small text-dark align-middle">
                          To: <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %>
                        </td>
                        <td class="small fw-bold text-danger align-middle">− Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else { %>
                        <td class="align-middle">
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.68rem;">⬆ Transfer Out</span>
                        </td>
                        <td class="small text-dark align-middle">To: <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %></td>
                        <td class="small fw-bold text-danger align-middle">− Rs. <%= row.amount.toLocaleString() %></td>
                      <% } %>
                      <td class="align-middle" style="font-size:0.78rem;">
                        <span class="text-dark">
                          <%= new Date(row.createdAt).toLocaleDateString('en-PK', { day:'2-digit', month:'short', year:'numeric' }) %>
                        </span>
                        <br>
                        <span class="text-muted">
                          <%= new Date(row.createdAt).toLocaleTimeString('en-PK', { hour:'2-digit', minute:'2-digit' }) %>
                        </span>
                      </td>
                      <td class="align-middle">
                        <% if (row.kind === 'sale' || row.kind === 'credit-payment') { %>
                          <a href="/sales/<%= row._id %>/invoice" target="_blank"
                             class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.72rem;">
                            🧾 Invoice
                          </a>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

        <% } else if (selectedAccount) { %>
          <!-- ── BANK TRANSACTIONS ── -->
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-semibold text-muted mb-0 text-uppercase" style="font-size:0.75rem;letter-spacing:.5px;">
              <%= selectedAccount.bankName %> — Transactions
            </h6>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
              Total: Rs. <%= (typeof selectedFilteredBalance !== "undefined" ? selectedFilteredBalance : 0).toLocaleString() %>
            </span>
          </div>

          <% if (transactions.length === 0) { %>
            <div class="text-center text-muted py-5 bg-white rounded border">
              <div class="fs-2 mb-2 opacity-25">🧾</div>
              <p class="small mb-0">Is account mein abhi koi transaction nahi.</p>
            </div>
          <% } else { %>
            <div class="bg-white rounded border overflow-hidden">
              <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="small text-muted fw-semibold py-2">Type</th>
                    <th class="small text-muted fw-semibold py-2">Detail</th>
                    <th class="small text-muted fw-semibold py-2">Amount</th>
                    <th class="small text-muted fw-semibold py-2">Date & Time</th>
                    <th class="small text-muted fw-semibold py-2"></th>
                  </tr>
                </thead>
                <tbody>
                  <% transactions.forEach(row => { %>
                    <tr>
                      <% if (row.kind === 'sale') { %>
                        <td class="align-middle">
                          <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.68rem;">💰 Sale</span>
                        </td>
                        <td class="small text-dark align-middle">
                          <span class="fw-semibold text-primary"><%= row.invoiceNumber %></span> — <%= row.customerName %>
                        </td>
                        <td class="small fw-bold text-success align-middle">+ Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'credit-payment') { %>
                        <td class="align-middle">
                          <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size:0.68rem;">💳 Credit Payment</span>
                        </td>
                        <td class="small text-dark align-middle">
                          <span class="fw-semibold text-primary"><%= row.invoiceNumber %></span> — <%= row.customerName %>
                        </td>
                        <td class="small fw-bold text-success align-middle">+ Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'transfer-in') { %>
                        <td class="align-middle">
                          <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.68rem;">⬇ Transfer In</span>
                        </td>
                        <td class="small text-dark align-middle">From: <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %></td>
                        <td class="small fw-bold text-success align-middle">+ Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'expense') { %>
                        <td class="align-middle">
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.68rem;">💸 Expense</span>
                        </td>
                        <td class="small text-dark align-middle text-capitalize">
                          <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %>
                        </td>
                        <td class="small fw-bold text-danger align-middle">− Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else if (row.kind === 'refund') { %>
                        <td class="align-middle">
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.68rem;">↩️ Refund</span>
                        </td>
                        <td class="small text-dark align-middle">
                          To: <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %>
                        </td>
                        <td class="small fw-bold text-danger align-middle">− Rs. <%= row.amount.toLocaleString() %></td>
                      <% } else { %>
                        <td class="align-middle">
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.68rem;">⬆ Transfer Out</span>
                        </td>
                        <td class="small text-dark align-middle">To: <%= row.counterparty %><% if (row.note) { %> — <span class="text-muted"><%= row.note %></span><% } %></td>
                        <td class="small fw-bold text-danger align-middle">− Rs. <%= row.amount.toLocaleString() %></td>
                      <% } %>
                      <td class="align-middle" style="font-size:0.78rem;">
                        <span class="text-dark">
                          <%= new Date(row.createdAt).toLocaleDateString('en-PK', { day:'2-digit', month:'short', year:'numeric' }) %>
                        </span>
                        <br>
                        <span class="text-muted">
                          <%= new Date(row.createdAt).toLocaleTimeString('en-PK', { hour:'2-digit', minute:'2-digit' }) %>
                        </span>
                      </td>
                      <td class="align-middle">
                        <% if (row.kind === 'sale' || row.kind === 'credit-payment') { %>
                          <a href="/sales/<%= row._id %>/invoice" target="_blank"
                             class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.72rem;">
                            🧾 Invoice
                          </a>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

        <% } else { %>
          <div class="text-center text-muted py-5 bg-white rounded border">
            <div class="fs-2 mb-2 opacity-25">👈</div>
            <p class="small mb-0">Koi account select karein transactions dekhne ke liye.</p>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<!-- Add Account Modal -->
<div class="modal fade" id="addAccountModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title fw-semibold">🏦 Naya Bank Account Add Karein</h6>
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
      </div>
      <form action="/bank-accounts/add" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Bank Ka Naam <span class="text-danger">*</span></label>
            <input type="text" name="bankName" class="form-control form-control-sm"
                   placeholder="e.g. HBL, UBL, Meezan, MCB" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Account Title <span class="text-danger">*</span></label>
            <input type="text" name="accountTitle" class="form-control form-control-sm"
                   placeholder="e.g. Main Business Account" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Account Number (Optional)</label>
            <input type="text" name="accountNumber" class="form-control form-control-sm"
                   placeholder="e.g. 1234-5678-9012">
          </div>
          <div class="mb-1">
            <label class="form-label small fw-semibold">Notes (Optional)</label>
            <input type="text" name="notes" class="form-control form-control-sm"
                   placeholder="Koi extra info...">
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">✅ Add Account</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Transfer Modal -->
<div class="modal fade" id="transferModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title fw-semibold">↔ Transfer Karein</h6>
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
      </div>
      <form action="/bank-accounts/transfer" method="POST" id="transferForm">
        <div class="modal-body">

          <div class="mb-3">
            <label class="form-label small fw-semibold">From <span class="text-danger">*</span></label>
            <select name="fromAccountSelect" id="fromAccountSelect" class="form-select form-select-sm" required onchange="syncTransferHidden()">
              <option value="cash">💵 Cash</option>
              <% transferAccountOptions.forEach(a => { %>
                <option value="<%= a._id %>"><%= a.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="text-center text-muted mb-2" style="font-size:1.1rem;">↓</div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">To <span class="text-danger">*</span></label>
            <select name="toAccountSelect" id="toAccountSelect" class="form-select form-select-sm" required onchange="syncTransferHidden()">
              <option value="cash">💵 Cash</option>
              <% transferAccountOptions.forEach(a => { %>
                <option value="<%= a._id %>"><%= a.label %></option>
              <% }) %>
            </select>
          </div>

          <div id="transferSameAccountWarning" class="alert alert-danger py-2 px-3 mb-3 d-none" style="font-size:12px;">
            ⚠️ From aur To account same nahi ho sakte.
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Amount (Rs.) <span class="text-danger">*</span></label>
            <input type="number" name="amount" id="transferAmount" class="form-control form-control-sm" placeholder="0" min="1" step="0.01" required>
          </div>

          <div class="mb-1">
            <label class="form-label small fw-semibold">Note (Optional)</label>
            <input type="text" name="note" class="form-control form-control-sm" placeholder="e.g. Customer ne cash diya, bank mein bhej diya">
          </div>

          <!-- Hidden fields jo route ko chahiye -->
          <input type="hidden" name="fromType" id="fromType">
          <input type="hidden" name="fromAccountId" id="fromAccountId">
          <input type="hidden" name="toType" id="toType">
          <input type="hidden" name="toAccountId" id="toAccountId">

        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm" id="transferSubmitBtn">↔ Transfer Karein</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function applyDateFilter() {
    const from    = document.getElementById('dateFrom').value;
    const to      = document.getElementById('dateTo').value;
    const url     = new URL(window.location.href);
    if (from) url.searchParams.set('dateFrom', from); else url.searchParams.delete('dateFrom');
    if (to)   url.searchParams.set('dateTo',   to);   else url.searchParams.delete('dateTo');
    window.location.href = url.toString();
  }

  function clearDateFilter() {
    const url = new URL(window.location.href);
    url.searchParams.delete('dateFrom');
    url.searchParams.delete('dateTo');
    window.location.href = url.toString();
  }

  // Agar date fields empty hain to aaj ki local date set karo
  function getLocalDate() {
    const d = new Date();
    const y = d.getFullYear();
    const m = String(d.getMonth()+1).padStart(2,'0');
    const day = String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${day}`;
  }

  const dfEl = document.getElementById('dateFrom');
  const dtEl = document.getElementById('dateTo');
  if (!dfEl.value) dfEl.value = getLocalDate();
  if (!dtEl.value) dtEl.value = getLocalDate();

  // Enter key se bhi filter ho
  ['dateFrom','dateTo'].forEach(id => {
    document.getElementById(id).addEventListener('keydown', e => {
      if (e.key === 'Enter') applyDateFilter();
    });
  });

  // ─── Transfer Modal ──────────────────────────────────────────────────────
  let transferModalInstance = null;

  function openTransferModal(prefillType, prefillAccountId, prefillLabel) {
    const fromSel = document.getElementById('fromAccountSelect');
    const toSel   = document.getElementById('toAccountSelect');

    // Reset
    fromSel.value = prefillType === 'cash' ? 'cash' : prefillAccountId;
    toSel.value = '';
    for (let o of toSel.options) {
      if (o.value !== fromSel.value) { toSel.value = o.value; break; }
    }
    document.getElementById('transferAmount').value = '';
    syncTransferHidden();

    if (!transferModalInstance) {
      transferModalInstance = new bootstrap.Modal(document.getElementById('transferModal'));
    }
    transferModalInstance.show();
  }

  function syncTransferHidden() {
    const fromSel = document.getElementById('fromAccountSelect');
    const toSel   = document.getElementById('toAccountSelect');
    const warning = document.getElementById('transferSameAccountWarning');
    const submitBtn = document.getElementById('transferSubmitBtn');

    const fromVal = fromSel.value;
    const toVal   = toSel.value;

    document.getElementById('fromType').value      = fromVal === 'cash' ? 'cash' : 'bank';
    document.getElementById('fromAccountId').value  = fromVal === 'cash' ? '' : fromVal;
    document.getElementById('toType').value         = toVal === 'cash' ? 'cash' : 'bank';
    document.getElementById('toAccountId').value    = toVal === 'cash' ? '' : toVal;

    const isSame = fromVal === toVal;
    warning.classList.toggle('d-none', !isSame);
    submitBtn.disabled = isSame;
  }

  document.getElementById('transferForm').addEventListener('submit', function (e) {
    syncTransferHidden();
    const fromVal = document.getElementById('fromAccountSelect').value;
    const toVal   = document.getElementById('toAccountSelect').value;
    if (fromVal === toVal) {
      e.preventDefault();
      document.getElementById('transferSameAccountWarning').classList.remove('d-none');
    }
  });
</script>
</body>
</html>
