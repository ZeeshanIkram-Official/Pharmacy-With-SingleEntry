<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= customer.name %> — Customer Ledger</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  body{ background:#f4f5f7; color:#212529; font-size:14px; }
  .mono{ font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; }
  .main{ margin-left:220px; }
  @media(max-width:768px){ .main{ margin-left:60px; } }

  .topbar{
    background:#fff; border-bottom:1px solid #dee2e6;
    padding:18px 28px; display:flex; align-items:center; justify-content:space-between;
    position:sticky; top:0; z-index:30;
  }
  .topbar .eyebrow{ font-size:9px; letter-spacing:2.5px; text-transform:uppercase; color:#6c757d; }
  .topbar h1{ font-size:20px; font-weight:600; margin:2px 0 0; }

  .wrap{ max-width:980px; margin:0 auto; padding:28px; }

  /* ── Ledger hero: the one number that matters ── */
  .ledger{
    background:#212529; color:#fff; border-radius:6px;
    padding:26px 30px; display:flex; align-items:flex-end; justify-content:space-between;
    gap:24px; flex-wrap:wrap; margin-bottom:22px;
  }
  .ledger .who{ font-size:11px; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,.55); margin-bottom:6px; }
  .ledger .since{ font-size:12px; color:rgba(255,255,255,.55); margin-top:4px; }
  .ledger .balance-label{ font-size:10px; letter-spacing:2px; text-transform:uppercase; opacity:.75; margin-bottom:4px; }
  .ledger .balance-value{ font-size:30px; font-weight:700; line-height:1; }
  .ledger .balance-value.owes{ color:#ff8a80; }
  .ledger .balance-value.credit-them{ color:#8ce6a8; }
  .ledger .balance-value.settled{ color:#fff; }
  .ledger .balance-tag{ font-size:11px; margin-top:6px; opacity:.7; }

  /* ── Quiet info strip ── */
  .info-strip{
    background:#fff; border:1px solid #dee2e6; border-radius:6px;
    display:grid; grid-template-columns:repeat(4,1fr); margin-bottom:22px; overflow:hidden;
  }
  .info-strip .cell{ padding:14px 16px; border-right:1px solid #dee2e6; }
  .info-strip .cell:last-child{ border-right:none; }
  .info-strip .lbl{ font-size:9px; letter-spacing:1.8px; text-transform:uppercase; color:#6c757d; margin-bottom:3px; }
  .info-strip .val{ font-size:13px; font-weight:600; }
  @media(max-width:700px){ .info-strip{ grid-template-columns:repeat(2,1fr); } .info-strip .cell:nth-child(2){ border-right:none; } }

  .metrics{ display:flex; gap:14px; margin-bottom:22px; flex-wrap:wrap; }
  .metric{ flex:1; min-width:160px; background:#fff; border:1px solid #dee2e6; border-radius:6px; padding:14px 16px; }
  .metric .lbl{ font-size:9px; letter-spacing:1.8px; text-transform:uppercase; color:#6c757d; margin-bottom:6px; }
  .metric .val{ font-size:20px; font-weight:700; }

  .section-title{
    font-size:10px; letter-spacing:2.5px; text-transform:uppercase; font-weight:700;
    color:#6c757d; margin-bottom:10px; display:flex; align-items:center; justify-content:space-between;
  }

  .ledger-table{ background:#fff; border:1px solid #dee2e6; border-radius:6px; overflow:hidden; }
  table{ width:100%; border-collapse:collapse; }
  thead th{
    font-size:9px; letter-spacing:1.8px; text-transform:uppercase; color:#6c757d; font-weight:700;
    text-align:left; padding:10px 16px; border-bottom:2px solid #212529;
  }
  thead th.num, td.num{ text-align:right; }
  tbody td{ padding:11px 16px; border-bottom:1px solid #dee2e6; font-size:13px; vertical-align:middle; }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr:hover{ background:#f8f9fa; }
  .inv-no{ font-family: ui-monospace, monospace; font-weight:700; color:#d68910; font-size:12.5px; }
  .pm-badge{
    font-size:10px; padding:3px 9px; border-radius:20px; font-weight:600; text-transform:capitalize;
    background:#eef2f6; color:#3c5366; display:inline-block;
  }
  .status-badge{ font-size:10px; padding:3px 9px; border-radius:20px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; }
  .status-paid{ background:#d1fae5; color:#166534; }
  .status-pending{ background:#fff3cd; color:#856404; }
  .status-unpaid{ background:#f8d7da; color:#842029; }
  .status-refunded{ background:#f1f1f1; color:#777; }
  .amt{ font-weight:700; }
  .btn-print{
    font-size:12px; padding:5px 12px; border:1px solid #dee2e6; border-radius:5px;
    background:#fff; color:#212529; text-decoration:none; display:inline-flex; align-items:center; gap:5px;
  }
  .btn-print:hover{ background:#212529; color:#fff; border-color:#212529; }

  .empty-row{ text-align:center; padding:50px 20px; color:#6c757d; font-size:13px; }

  .btn-outline-ink{ border:1px solid #ced4da; color:#212529; background:#fff; font-size:13px; padding:7px 16px; border-radius:5px; }
  .btn-outline-ink:hover{ background:#e9ecef; color:#212529; }
  .btn-ink-solid{ background:#0d6efd; color:#fff; font-size:13px; padding:7px 16px; border-radius:5px; border:1px solid #0d6efd; }
  .btn-ink-solid:hover{ background:#0b5ed7; color:#fff; }
</style>
</head>
<body>

<%- include('../partials/sidebar') %>

<main class="main">

  <div class="topbar">
    <div>
      <div class="eyebrow">Customer Ledger</div>
      <h1><%= customer.name %></h1>
    </div>
    <div class="d-flex gap-2">
      <a href="/customers/<%= customer._id %>/edit" class="btn-outline-ink">✏️ Edit</a>
      <a href="/sales/new" class="btn-ink-solid">🛒 New Sale</a>
    </div>
  </div>

  <div class="wrap">

    <%
      const owed     = typeof creditOwed !== 'undefined' ? (creditOwed || 0) : 0;
      const advance   = customer.walletBalance || 0;
      const netBalance = advance - owed; // positive = shop owes customer, negative = customer owes shop
    %>

    <!-- ── Ledger Hero: the one number a cashier needs ── -->
    <div class="ledger">
      <div>
        <div class="who">Account Standing</div>
        <div style="font-size:18px; font-weight:600;"><%= customer.name %></div>
        <div class="since">
          Customer since <%= new Date(customer.createdAt).toLocaleDateString('en-PK', {year:'numeric', month:'long', day:'numeric'}) %>
        </div>
      </div>
      <div class="text-end">
        <% if (netBalance < 0) { %>
          <div class="balance-label">Customer Owes</div>
          <div class="balance-value owes">Rs. <%= Math.abs(netBalance).toLocaleString() %></div>
          <div class="balance-tag">🔴 Outstanding credit</div>
        <% } else if (netBalance > 0) { %>
          <div class="balance-label">Shop Owes Customer</div>
          <div class="balance-value credit-them">Rs. <%= netBalance.toLocaleString() %></div>
          <div class="balance-tag">💰 Advance on file</div>
        <% } else { %>
          <div class="balance-label">Account Standing</div>
          <div class="balance-value settled">Rs. 0</div>
          <div class="balance-tag">✓ Settled in full</div>
        <% } %>
      </div>
    </div>

    <!-- ── Contact strip ── -->
    <div class="info-strip">
      <div class="cell">
        <div class="lbl">Phone</div>
        <div class="val mono"><%= customer.phone || '—' %></div>
      </div>
      <div class="cell">
        <div class="lbl">WhatsApp</div>
        <div class="val mono"><%= customer.whatsapp || '—' %></div>
      </div>
      <div class="cell">
        <div class="lbl">Address</div>
        <div class="val"><%= customer.address || '—' %></div>
      </div>
      <div class="cell">
        <div class="lbl">Notes</div>
        <div class="val"><%= customer.notes || '—' %></div>
      </div>
    </div>

    <!-- ── Quiet lifetime metrics ── -->
    <div class="metrics">
      <div class="metric">
        <div class="lbl">Total Purchases</div>
        <div class="val"><%= customer.totalPurchases || 0 %></div>
      </div>
      <div class="metric">
        <div class="lbl">Lifetime Spent</div>
        <div class="val">Rs. <%= (customer.totalSpent || 0).toLocaleString() %></div>
      </div>
      <div class="metric">
        <div class="lbl">Advance Balance</div>
        <div class="val" style="color:#166534">Rs. <%= advance.toLocaleString() %></div>
      </div>
      <div class="metric">
        <div class="lbl">Credit Owed</div>
        <div class="val" style="color:#9b1c1c">Rs. <%= owed.toLocaleString() %></div>
      </div>
    </div>

    <!-- ── Purchase History ── -->
    <div class="section-title">
      <span>Purchase History</span>
      <span class="mono" style="font-weight:400; letter-spacing:0;"><%= sales.length %> invoice<%= sales.length !== 1 ? 's' : '' %></span>
    </div>

    <div class="ledger-table">
      <table>
        <thead>
          <tr>
            <th>Invoice</th>
            <th>Date</th>
            <th class="num">Items</th>
            <th>Payment</th>
            <th class="num">Total</th>
            <th class="num">Paid</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!sales || sales.length === 0) { %>
            <tr><td colspan="8" class="empty-row">No invoices yet — this customer hasn't made a purchase.</td></tr>
          <% } else { %>
            <% sales.forEach(sale => {
              const baaki = (sale.totalAmount || 0) - (sale.amountPaid || 0);
              let status = 'paid';
              if (sale.status === 'refunded') status = 'refunded';
              else if ((sale.amountPaid || 0) === 0 && baaki > 0) status = 'unpaid';
              else if (baaki > 0) status = 'pending';
            %>
            <tr>
              <td><span class="inv-no"><%= sale.invoiceNumber %></span></td>
              <td style="color:#777;">
                <%= new Date(sale.createdAt).toLocaleDateString('en-PK', {day:'numeric', month:'short', year:'numeric'}) %>
              </td>
              <td class="num" style="color:#777;"><%= sale.items.length %></td>
              <td><span class="pm-badge"><%= sale.paymentMethod %></span></td>
              <td class="num amt">Rs. <%= (sale.totalAmount || 0).toLocaleString() %></td>
              <td class="num" style="color:#166534; font-weight:600;">Rs. <%= (sale.amountPaid || 0).toLocaleString() %></td>
              <td><span class="status-badge status-<%= status %>"><%= status %></span></td>
              <td class="text-end">
                <a href="/sales/<%= sale._id %>/invoice" class="btn-print" target="_blank">🖨️ Print</a>
              </td>
            </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</main>

</body>
</html>
