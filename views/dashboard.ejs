<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f5f7; font-size: 14px; }
    .main { margin-left: 220px; }
    .stat-card { position: relative; overflow: hidden; border-top: 3px solid transparent; }
    .stat-card.blue  { border-top-color: #1a6fbc; }
    .stat-card.pink  { border-top-color: #8e44ad; }
    .stat-card.green { border-top-color: #1e7e34; }
    .stat-card.orange{ border-top-color: #c87000; }
    .stat-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 500; }
    .stat-value { font-size: 1.65rem; font-weight: 700; line-height: 1; }
    .topbar { position: sticky; top: 0; z-index: 50; }
    .invoice-link { color: #d68910; text-decoration: none; font-weight: 600; }
    .invoice-link:hover { text-decoration: underline; }
    @keyframes fadeUp { from { opacity:0; transform:translateY(14px);} to {opacity:1;transform:translateY(0);} }
    .stat-card:nth-child(1){animation:fadeUp 0.4s 0.05s ease both;}
    .stat-card:nth-child(2){animation:fadeUp 0.4s 0.10s ease both;}
    .stat-card:nth-child(3){animation:fadeUp 0.4s 0.15s ease both;}
    .stat-card:nth-child(4){animation:fadeUp 0.4s 0.20s ease both;}
    @media(max-width:768px){ .main{ margin-left:60px; } }
  </style>
</head>
<body>

  <%- include('./partials/sidebar') %>

  <main class="main">

    <%# Topbar %>
    <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm">
      <h2 class="fs-6 fw-semibold mb-0">📊 Dashboard</h2>
      <div class="d-flex gap-2 align-items-center">
        <span class="text-muted small">
          <%= new Date().toLocaleDateString('en-PK', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
        </span>
        <a href="/sales/new" class="btn btn-primary btn-sm">🛒 New Sale</a>
      </div>
    </div>

    <div class="p-4">

      <%# Stats Grid %>
      <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
          <div class="card stat-card blue h-100 p-3 shadow-sm">
            <div class="stat-label text-secondary mb-2">Today's Revenue</div>
            <div class="stat-value mb-1">Rs. <%= todayRevenue.toLocaleString() %></div>
            <div class="small text-muted"><%= todaySalesCount %> sales today</div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="card stat-card pink h-100 p-3 shadow-sm">
            <div class="stat-label text-secondary mb-2">Monthly Revenue</div>
            <div class="stat-value mb-1">Rs. <%= monthRevenue.toLocaleString() %></div>
            <div class="small text-muted"><%= monthSalesCount %> sales this month</div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="card stat-card green h-100 p-3 shadow-sm">
            <div class="stat-label text-secondary mb-2">Total Products</div>
            <div class="stat-value mb-1"><%= totalProducts %></div>
            <div class="small text-muted">Active products</div>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="card stat-card orange h-100 p-3 shadow-sm">
            <div class="stat-label text-secondary mb-2">Customers</div>
            <div class="stat-value mb-1"><%= totalCustomers %></div>
            <div class="small text-muted">Registered</div>
          </div>
        </div>

      </div>

      <%# Low Stock Alert %>
      <!-- <% if (lowStockProducts.length > 0) { %>
        <div class="alert alert-warning border-start border-warning border-4 mb-4">
          ⚠️ <strong><%= lowStockProducts.length %> products</strong> are running low on stock!
          <a href="/inventory" class="ms-2 alert-link">View Inventory →</a>
        </div>
      <% } %> -->

      <div class="row g-4">

        <%# Recent Sales %>
        <div class="col-12 col-lg-6">
          <div class="card shadow-sm">
            <div class="card-header bg-light d-flex align-items-center justify-content-between py-3">
              <h6 class="mb-0 fw-semibold">🧾 Recent Sales</h6>
              <a href="/sales" class="btn btn-outline-secondary btn-sm">View All</a>
            </div>
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="text-uppercase small text-muted fw-semibold px-3">Invoice</th>
                    <th class="text-uppercase small text-muted fw-semibold">Customer</th>
                    <th class="text-uppercase small text-muted fw-semibold">Amount</th>
                    <th class="text-uppercase small text-muted fw-semibold">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentSales.length === 0) { %>
                    <tr><td colspan="4" class="text-center text-muted py-4">No sales yet</td></tr>
                  <% } %>
                  <% recentSales.forEach(sale => { %>
                    <tr>
                      <td class="px-3">
                        <a href="/sales/<%= sale._id %>/invoice" class="invoice-link">
                          <%= sale.invoiceNumber %>
                        </a>
                        <div class="text-muted small mt-1"><%= moment(sale.createdAt).fromNow() %></div>
                      </td>
                      <td><%= sale.customerName %></td>
                      <td class="fw-bold">
                        <% if (sale.status === 'refunded' || sale.totalAmount === 0) { %>
                          <span class="text-muted text-decoration-line-through" style="font-size:12px;">
                            Rs. <%= (sale.totalRefunded || 0).toLocaleString() %>
                          </span>
                        <% } else { %>
                          Rs. <%= sale.totalAmount.toLocaleString() %>
                        <% } %>
                      </td>
                      <td>
                        <% const isRefunded = sale.status==='refunded' || sale.totalAmount===0;
                           const isPaid = !isRefunded && sale.amountPaid >= sale.totalAmount;
                           const isPartial = !isRefunded && sale.amountPaid > 0 && sale.amountPaid < sale.totalAmount; %>
                        <% if (isRefunded) { %>
                          <span class="badge bg-danger">↩ Refunded</span>
                        <% } else if (isPaid) { %>
                          <span class="badge bg-success">Paid</span>
                        <% } else if (isPartial) { %>
                          <span class="badge bg-warning text-dark">Partial</span>
                        <% } else { %>
                          <span class="badge bg-danger">Unpaid</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# Top Products %>
        <div class="col-12 col-lg-6">
          <div class="card shadow-sm">
            <div class="card-header bg-light py-3">
              <h6 class="mb-0 fw-semibold">🏆 Top Products This Month</h6>
            </div>
            <div class="card-body">
              <% if (topProducts.length === 0) { %>
                <div class="text-center py-4 text-muted">
                  <div class="fs-2 mb-2 opacity-25">📦</div>
                  <p class="mb-0 small">No sales data yet</p>
                </div>
              <% } %>
              <% topProducts.forEach((p, i) => { %>
                <div class="mb-3">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold small">#<%= i+1 %> <%= p._id %></span>
                    <span class="text-muted small"><%= p.totalQty %> sold</span>
                  </div>
                  <div class="progress" style="height:5px;">
                    <div class="progress-bar bg-primary" style="width:<%= Math.min(100,(p.totalQty/(topProducts[0]?.totalQty||1))*100) %> "%></div>
                  </div>
                  <div class="text-end text-muted mt-1" style="font-size:12px;">
                    Rs. <%= p.totalRevenue.toLocaleString() %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

      </div>

      <%# Low Stock Table %>
      <!-- <% if (lowStockProducts.length > 0) { %>
        <div class="card shadow-sm mt-4">
          <div class="card-header bg-light d-flex align-items-center justify-content-between py-3">
            <h6 class="mb-0 fw-semibold">⚠️ Low Stock Products</h6>
            <a href="/inventory" class="btn btn-warning btn-sm">Manage Inventory</a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
              <thead class="table-light">
                <tr>
                  <th class="text-uppercase small text-muted fw-semibold px-3">Product</th>
                  <th class="text-uppercase small text-muted fw-semibold">Category</th>
                  <th class="text-uppercase small text-muted fw-semibold">Stock</th>
                  <th class="text-uppercase small text-muted fw-semibold">Min Stock</th>
                  <th class="text-uppercase small text-muted fw-semibold">Action</th>
                </tr>
              </thead>
              <tbody>
                <% lowStockProducts.forEach(p => { %>
                  <tr>
                    <td class="fw-bold px-3"><%= p.name %></td>
                    <td class="text-muted"><%= p.category %></td>
                    <td>
                      <span class="badge <%= p.stock === 0 ? 'bg-danger' : 'bg-warning text-dark' %>">
                        <%= p.stock %> <%= p.unit %>(s)
                      </span>
                    </td>
                    <td class="text-muted"><%= p.minStock %></td>
                    <td><a href="/products" class="btn btn-outline-secondary btn-sm">Restock</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %> -->

    </div>
  </main>

</body>
</html>
