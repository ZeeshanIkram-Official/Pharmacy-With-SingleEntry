<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Medicine</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f5f7; font-size: 14px; }
    .main { margin-left: 220px; }
    .topbar { position: sticky; top: 0; z-index: 50; }
    .profit-preview { display: none; }
    .profit-preview.visible { display: flex; }
    .section-label {
      font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px;
      color: #5a6270; border-bottom: 1px solid #e2e4e9; padding-bottom: 8px;
      margin-bottom: 16px; margin-top: 4px;
    }
    @media(max-width:768px) { .main { margin-left: 60px; } }
  </style>
</head>

<body>
  <%- include('../partials/sidebar') %>

  <main class="main">
    <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm">
      <h2 class="fs-6 fw-semibold mb-0">💊 Add New Medicine</h2>
      <a href="<%= (typeof returnTo !== 'undefined' && returnTo) ? returnTo : '/products' %>" class="btn btn-outline-secondary btn-sm">← Back</a>
    </div>

    <div class="p-4">
      <% if (error) { %>
        <div class="alert alert-danger border-start border-danger border-4">❌ <%= error %></div>
      <% } %>

      <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
          <h6 class="mb-0 fw-semibold">Medicine Details</h6>
        </div>
        <div class="card-body p-4">
          <form action="/products" method="POST">
            <% if (typeof returnTo !== 'undefined' && returnTo) { %>
              <input type="hidden" name="returnTo" value="<%= returnTo %>">
            <% } %>

            <div class="section-label">Basic Info</div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Medicine Name *</label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Panadol 500mg"
                       value="<%= typeof prefillName !== 'undefined' ? prefillName : '' %>" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Generic Name</label>
                <input type="text" name="genericName" class="form-control" placeholder="e.g. Paracetamol">
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Manufacturer *</label>
                <input type="text" name="manufacturer" class="form-control" placeholder="e.g. GSK" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Category *</label>
                <select name="category" class="form-select" required>
                  <option value="">Select Category</option>
                  <% categories.forEach(c=> { %>
                    <option value="<%= c %>"><%= c %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="row g-3 mb-3 align-items-center">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Min Stock Alert (Tablets/Units)</label>
                <input type="number" name="minStockBoxes" class="form-control" placeholder="5" min="0" value="5">
              </div>
              <div class="col-md-6 pt-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="requiresPrescription" id="rxCheck">
                  <label class="form-check-label small fw-semibold text-secondary" for="rxCheck">
                    ⚠️ Requires Prescription (bina prescription sale na ho)
                  </label>
                </div>
              </div>
            </div>

            <div class="section-label">Initial Stock</div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Initial Stock (Tablets / Units)</label>
                <input type="number" name="stockQty" class="form-control" placeholder="0" min="0" step="any" value="0" oninput="calcProfit()">
                <div class="form-text">Jitni tablets/pieces abhi maujood hain, seedha unki ginti daal dein</div>
              </div>
            </div>
            <div class="form-text mb-3">
              Stock chhod dein agar abhi dalna nahi hai — baad mein "Add Stock" se dala ja sakta hai.
            </div>

            <div class="section-label">Pricing (Per Tablet/Unit)</div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Purchase Price (Rs. / tablet) *</label>
                <input type="number" name="purchasePrice" class="form-control" placeholder="0" min="0" step="0.01" required oninput="calcProfit()">
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Selling Price (Rs. / tablet) *</label>
                <input type="number" name="sellingPrice" class="form-control" placeholder="0" min="0" step="0.01" required oninput="calcProfit()">
              </div>
            </div>

            <div id="profitPreview" class="profit-preview alert alert-light border mb-3">
              <div class="d-flex gap-5 align-items-center mb-2">
                <div>
                  <div class="small text-muted mb-1">Profit / Tablet</div>
                  <div class="fw-bold fs-5 text-success" id="profitVal">Rs. 0</div>
                </div>
                <div>
                  <div class="small text-muted mb-1">Margin</div>
                  <div class="fw-bold fs-5 text-warning" id="marginVal">0%</div>
                </div>
              </div>
            </div>

            <div class="section-label">Extra</div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Barcode</label>
              <input type="text" name="barcode" class="form-control" placeholder="Scan or enter barcode">
            </div>

            <div class="mb-4">
              <label class="form-label small fw-semibold text-secondary">Description (optional)</label>
              <textarea name="description" class="form-control" rows="3" placeholder="Medicine description / salt composition..."></textarea>
            </div>

            <div class="d-flex gap-2 pt-3 border-top">
              <button type="submit" class="btn btn-primary">✅ Add Medicine</button>
              <a href="<%= (typeof returnTo !== 'undefined' && returnTo) ? returnTo : '/products' %>" class="btn btn-outline-secondary">Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </main>

  <script>
    function calcProfit() {
      const buy = parseFloat(document.querySelector('[name=purchasePrice]').value) || 0;
      const sell = parseFloat(document.querySelector('[name=sellingPrice]').value) || 0;

      const profit = sell - buy;
      const margin = buy > 0 ? ((profit / buy) * 100).toFixed(1) : 0;

      document.getElementById('profitVal').textContent = `Rs. ${profit.toLocaleString()}`;
      document.getElementById('profitVal').className = `fw-bold fs-5 ${profit >= 0 ? 'text-success' : 'text-danger'}`;
      document.getElementById('marginVal').textContent = `${margin}%`;

      document.getElementById('profitPreview').classList.add('visible');
    }
  </script>
</body>
</html>
