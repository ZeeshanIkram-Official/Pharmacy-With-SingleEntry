<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Medicine</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f5f7; font-size: 14px; }
    .main { margin-left: 220px; }
    .topbar { position: sticky; top: 0; z-index: 50; }
    .section-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: #5a6270; border-bottom: 1px solid #e2e4e9; padding-bottom: 8px; margin-bottom: 16px; margin-top: 4px; }
    @media(max-width:768px){ .main{ margin-left:60px; } }
  </style>
</head>
<body>

<%- include('../partials/sidebar') %>

<main class="main">

  <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm">
    <h2 class="fs-6 fw-semibold mb-0">✏️ Edit Medicine — <%= product.name %></h2>
    <a href="/products" class="btn btn-outline-secondary btn-sm">← Back</a>
  </div>

  <div class="p-4">

    <% if (error) { %>
      <div class="alert alert-danger border-start border-danger border-4">❌ <%= error %></div>
    <% } %>

    <div class="row g-4">

      <%# LEFT: Basic Info %>
      <div class="col-lg-5">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-light py-3">
            <h6 class="mb-0 fw-semibold">💊 Medicine Info</h6>
          </div>
          <div class="card-body p-4">
            <form action="/products/<%= product._id %>?_method=PUT" method="POST">

              <div class="section-label">Basic Info</div>

              <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Medicine Name *</label>
                <input type="text" name="name" class="form-control" value="<%= product.name %>" required>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Generic Name</label>
                <input type="text" name="genericName" class="form-control" value="<%= product.genericName || '' %>">
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Manufacturer *</label>
                <input type="text" name="manufacturer" class="form-control" value="<%= product.manufacturer %>" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Category *</label>
                  <select name="category" class="form-select" required>
                    <% categories.forEach(c => { %>
                      <option value="<%= c %>" <%= product.category === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" name="requiresPrescription" id="rxCheck" <%= product.requiresPrescription ? 'checked' : '' %>>
                <label class="form-check-label small fw-semibold text-secondary" for="rxCheck">⚠️ Requires Prescription</label>
              </div>

              <div class="section-label">Pricing &amp; Stock Limits</div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Purchase Price (Rs. / tablet) *</label>
                  <input type="number" name="purchasePrice" class="form-control" value="<%= product.purchasePrice %>" min="0" step="0.01" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Selling Price (Rs. / tablet) *</label>
                  <input type="number" name="sellingPrice" class="form-control" value="<%= product.sellingPrice %>" min="0" step="0.01" required>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label small fw-semibold text-secondary">Min Stock Alert (Tablets/Units)</label>
                  <input type="number" name="minStockBoxes" class="form-control" value="<%= product.minStockBoxes %>" min="0">
                </div>
              </div>

              <div class="form-text mb-3">
                Total Stock: <strong><%= Number(product.stockBoxes.toFixed(2)) %> tablets/units</strong> — neeche "Add Stock" se update karein.
              </div>

              <div class="section-label">Extra</div>

              <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Barcode</label>
                <input type="text" name="barcode" class="form-control" value="<%= product.barcode || '' %>">
              </div>

              <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary">Description</label>
                <textarea name="description" class="form-control" rows="2"><%= product.description || '' %></textarea>
              </div>

              <div class="d-flex gap-2 pt-3 border-top">
                <button type="submit" class="btn btn-primary btn-sm">💾 Save Changes</button>
                <a href="/products" class="btn btn-outline-secondary btn-sm">Cancel</a>
              </div>

            </form>
          </div>
        </div>
      </div>

      <%# RIGHT: Add Stock %>
      <div class="col-lg-7">

        <div class="card shadow-sm border-success">
          <div class="card-header bg-success bg-opacity-10 py-2">
            <h6 class="mb-0 fw-semibold text-success">➕ Add Stock (New Stock Aaya)</h6>
          </div>
          <div class="card-body p-3">
            <form action="/products/<%= product._id %>/add-stock" method="POST">
              <div class="row g-2 mb-2">
                <div class="col-4">
                  <label class="form-label small fw-semibold text-secondary">Quantity (Tablets/Units) *</label>
                  <input type="number" name="quantity" class="form-control form-control-sm" placeholder="Kitni tablets/units aayin" min="0.01" step="any" required oninput="calcRestockProfit()">
                </div>
                <div class="col-4">
                  <label class="form-label small fw-semibold text-secondary">Purchase Price (Rs./tablet)</label>
                  <input type="number" id="restockBuy" name="purchasePrice" class="form-control form-control-sm" placeholder="<%= product.purchasePrice %>" min="0" step="0.01" oninput="calcRestockProfit()">
                </div>
                <div class="col-4">
                  <label class="form-label small fw-semibold text-secondary">Selling Price (Rs./tablet)</label>
                  <input type="number" id="restockSell" name="sellingPrice" class="form-control form-control-sm" placeholder="<%= product.sellingPrice %>" min="0" step="0.01" oninput="calcRestockProfit()">
                </div>
              </div>
              <div class="form-text small text-muted mb-2">
                Stock seedha total mein add ho jata hai (batch-wise tracking nahi hoti).
              </div>
              <div id="restockProfitPreview" class="alert alert-light border py-2 px-3 mb-2 small" style="display:none;">
                Profit/Tablet: <strong id="rpVal" class="text-success">—</strong> &nbsp;|&nbsp;
                Margin: <strong id="rmVal" class="text-warning">—</strong>
              </div>
              <button type="submit" class="btn btn-success btn-sm">✅ Add Stock</button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function calcRestockProfit() {
  const buyInput  = document.getElementById('restockBuy');
  const sellInput = document.getElementById('restockSell');
  const buy  = parseFloat(buyInput.value)  || <%= product.purchasePrice %>;
  const sell = parseFloat(sellInput.value) || <%= product.sellingPrice %>;

  const profit = sell - buy;
  const margin = buy > 0 ? ((profit / buy) * 100).toFixed(1) : 0;

  const preview = document.getElementById('restockProfitPreview');
  preview.style.display = 'block';

  document.getElementById('rpVal').textContent = `Rs. ${profit.toLocaleString()}`;
  document.getElementById('rpVal').className   = `fw-bold ${profit >= 0 ? 'text-success' : 'text-danger'}`;
  document.getElementById('rmVal').textContent = `${margin}%`;
}
</script>

</body>
</html>
