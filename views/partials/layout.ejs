@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

:root {
  --bg: #f4f5f7;
  --surface: #ffffff;
  --surface2: #f9fafb;
  --surface3: #f1f3f5;
  --border: #e2e4e9;
  --border2: #d0d3db;
  --accent: #1a6fbc;
  --accent-hover: #155fa3;
  --accent-light: #e8f0fb;
  --text: #1a1d23;
  --text2: #5a6270;
  --text3: #8a9099;
  --danger: #c0392b;
  --danger-light: #fdf0ef;
  --success: #1e7e34;
  --success-light: #edf7f0;
  --warning: #d68910;
  --warning-light: #fef9ec;
  --info: #1565a8;
  --radius: 6px;
  --radius-sm: 4px;
  --shadow: 0 1px 4px rgba(0,0,0,0.08);
  --shadow-md: 0 2px 8px rgba(0,0,0,0.10);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Inter', 'Segoe UI', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  font-size: 14px;
}

/* ── SIDEBAR ── */
.sidebar {
  width: 220px;
  min-height: 100vh;
  background: #1c2a3a;
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0; left: 0;
  z-index: 100;
}

.logo {
  padding: 20px 18px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.logo h1 {
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0;
}

.logo h1 span { color: #5ba3e8; }

.logo small {
  font-size: 0.68rem;
  color: rgba(255,255,255,0.4);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

nav { padding: 10px 10px; flex: 1; }

nav a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 500;
  margin-bottom: 1px;
  transition: all 0.15s;
}

nav a:hover { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.9); }
nav a.active { background: var(--accent); color: #fff; }
nav a .icon { font-size: 1rem; width: 18px; text-align: center; opacity: 0.85; }

.sidebar-footer {
  padding: 14px;
  border-top: 1px solid rgba(255,255,255,0.08);
  font-size: 0.7rem;
  color: rgba(255,255,255,0.3);
  text-align: center;
}

/* ── MAIN ── */
.main {
  margin-left: 220px;
  flex: 1;
  min-height: 100vh;
}

.topbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 13px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: var(--shadow);
}

.topbar h2 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text);
}

.topbar-actions { display: flex; gap: 10px; align-items: center; }

.content { padding: 22px 28px; }

/* ── STAT CARDS ── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 14px;
  margin-bottom: 22px;
}

.stat-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}

.stat-card.blue::before  { background: #1a6fbc; }
.stat-card.pink::before  { background: #8e44ad; }
.stat-card.green::before { background: #1e7e34; }
.stat-card.orange::before{ background: #c87000; }

.stat-card .label {
  font-size: 0.72rem;
  color: var(--text2);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 8px;
  font-weight: 500;
}

.stat-card .value {
  font-size: 1.65rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 5px;
  color: var(--text);
}

.stat-card .sub { font-size: 0.75rem; color: var(--text3); }

/* ── LAYOUT GRIDS ── */
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; }

/* ── CARD ── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.card-header {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface2);
}

.card-header h3 {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text);
}

.card-body { padding: 18px; }

/* ── TABLE ── */
.table-wrap { overflow-x: auto; }

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
}

thead th {
  padding: 10px 14px;
  text-align: left;
  font-size: 0.72rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--text2);
  background: var(--surface2);
  border-bottom: 1px solid var(--border);
  border-top: 1px solid var(--border);
}

tbody tr { border-bottom: 1px solid var(--border); transition: background 0.1s; }
tbody tr:hover { background: var(--surface2); }
tbody tr:last-child { border-bottom: none; }

td { padding: 10px 14px; color: var(--text); vertical-align: middle; }

/* ── BUTTONS ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-family: 'Inter', sans-serif;
  font-size: 0.83rem;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid transparent;
  text-decoration: none;
  transition: all 0.15s;
  white-space: nowrap;
}

.btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
.btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }

.btn-success { background: var(--success); color: #fff; border-color: var(--success); }
.btn-success:hover { background: #176a2b; }

.btn-danger { background: var(--danger); color: #fff; border-color: var(--danger); }
.btn-danger:hover { background: #a93226; }

.btn-warning { background: var(--warning); color: #fff; border-color: var(--warning); }
.btn-warning:hover { background: #b7770d; }

.btn-outline {
  background: transparent;
  border: 1px solid var(--border2);
  color: var(--text2);
}
.btn-outline:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-light); }

.btn-sm { padding: 5px 11px; font-size: 0.78rem; }
.btn-lg { padding: 11px 24px; font-size: 0.95rem; }

/* ── FORMS ── */
.form-group { margin-bottom: 16px; }

label {
  display: block;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 5px;
}

input, select, textarea {
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  color: var(--text);
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  transition: border-color 0.15s;
  outline: none;
}

input:focus, select:focus, textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(26,111,188,0.12);
}

select option { background: #fff; }

.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }

/* ── BADGES ── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 9px;
  border-radius: 3px;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  border: 1px solid transparent;
}

.badge-success { background: var(--success-light); color: var(--success); border-color: #b7dfbf; }
.badge-danger  { background: var(--danger-light);  color: var(--danger);  border-color: #f0c0bc; }
.badge-warning { background: var(--warning-light); color: var(--warning); border-color: #f0d8a0; }
.badge-info    { background: var(--accent-light);  color: var(--accent);  border-color: #b0ccee; }
.badge-accent  { background: var(--accent-light);  color: var(--accent);  border-color: #b0ccee; }

/* ── ALERTS ── */
.alert {
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  margin-bottom: 18px;
  font-size: 0.85rem;
  border: 1px solid transparent;
  border-left: 4px solid;
}

.alert-danger  { background: var(--danger-light);  border-color: var(--danger);  color: var(--danger); }
.alert-success { background: var(--success-light); border-color: var(--success); color: var(--success); }
.alert-warning { background: var(--warning-light); border-color: var(--warning); color: var(--warning); }

/* ── SEARCH BAR ── */
.search-bar {
  display: flex;
  gap: 10px;
  margin-bottom: 18px;
  align-items: center;
}

.search-input-wrap { position: relative; flex: 1; }
.search-input-wrap input { padding-left: 36px; }
.search-input-wrap .search-icon {
  position: absolute;
  left: 11px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text3);
  font-size: 0.9rem;
}

/* ── POS LAYOUT ── */
.pos-layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 16px;
  height: calc(100vh - 80px);
}

.pos-left { display: flex; flex-direction: column; gap: 14px; overflow: hidden; }
.pos-right { display: flex; flex-direction: column; gap: 0; }

.product-search-results {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 8px;
  overflow-y: auto;
  max-height: 300px;
  padding: 2px;
}

.product-tile {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 10px;
  cursor: pointer;
  transition: all 0.15s;
  text-align: center;
}

.product-tile:hover { border-color: var(--accent); background: var(--accent-light); }

.product-tile .p-name  { font-size: 0.78rem; font-weight: 600; margin-bottom: 4px; color: var(--text); }
.product-tile .p-price { font-size: 0.95rem; font-weight: 700; color: var(--accent); }
.product-tile .p-stock { font-size: 0.68rem; color: var(--text3); }

/* ── CART ── */
.cart-table { flex: 1; overflow-y: auto; }

.cart-item {
  display: grid;
  grid-template-columns: 2fr 88px 90px 80px 30px;
  gap: 8px;
  padding: 10px 16px;
  align-items: center;
  border-bottom: 1px solid var(--border);
  font-size: 0.82rem;
}

.cart-item-name { flex: 1; font-weight: 500; color: var(--text); }

.cart-qty-controls { display: flex; align-items: center; gap: 4px; }

.cart-qty-controls button {
  width: 24px; height: 24px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border2);
  background: var(--surface2);
  color: var(--text);
  cursor: pointer;
  font-size: 0.9rem;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.12s;
}

.cart-qty-controls button:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
.cart-qty { width: 28px; text-align: center; font-weight: 600; }
.cart-item-price { font-weight: 700; color: var(--success); min-width: 65px; text-align: right; }
.remove-btn { background: none; border: none; color: var(--danger); cursor: pointer; font-size: 0.95rem; padding: 3px; }

/* ── BILL SUMMARY ── */
.pos-right {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  padding: 14px;
}

.bill-row {
  display: flex;
  justify-content: space-between;
  padding: 4px 0;
  font-size: 0.83rem;
  color: var(--text2);
}

.bill-row.total {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text);
  border-top: 2px solid var(--border);
  padding-top: 10px;
  margin-top: 6px;
}

.payment-section { padding: 14px; border-top: 1px solid var(--border); }

/* ── INVOICE ── */
.invoice-wrap {
  max-width: 700px;
  margin: 0 auto;
  background: white;
  color: #111;
  padding: 40px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-md);
}

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .pos-layout { grid-template-columns: 1fr; }
  .grid-2 { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .sidebar { width: 52px; }
  .sidebar .logo h1 span, nav a span, .sidebar-footer, .logo small { display: none; }
  .main { margin-left: 52px; }
  .content { padding: 14px; }
}
@media (max-width: 768px) {
  .sidebar {
    width: 60px;
  }

  .main {
    margin-left: 60px;
    width: calc(100% - 60px);
  }

  /* hide text, keep icons centered */
  .logo h1,
  .logo small,
  nav a span,
  .sidebar-footer {
    display: none;
  }

  nav a {
    justify-content: center;
    padding: 10px 0;
  }

  nav a .icon {
    margin: 0;
    font-size: 1.1rem;
  }

  .content {
    padding: 14px;
  }
}
/* ── EMPTY STATE ── */
.empty-state {
  text-align: center;
  padding: 50px 20px;
  color: var(--text3);
}
.empty-state .icon { font-size: 2.5rem; margin-bottom: 14px; opacity: 0.35; }
.empty-state h3 { font-size: 0.95rem; margin-bottom: 6px; color: var(--text2); }

/* ── PROGRESS ── */
.progress { background: var(--surface3); border-radius: 3px; height: 5px; overflow: hidden; }
.progress-bar { height: 100%; border-radius: 3px; background: var(--accent); transition: width 0.4s; }

/* ── UTILITIES ── */
.text-muted   { color: var(--text3); font-size: 0.8rem; }
.text-danger  { color: var(--danger); }
.text-success { color: var(--success); }
.text-accent  { color: var(--accent); }
.fw-bold      { font-weight: 700; }
.mb-4         { margin-bottom: 22px; }
.mt-4         { margin-top: 22px; }
.flex         { display: flex; }
.gap-2        { gap: 8px; }
.gap-3        { gap: 12px; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.w-full       { width: 100%; }
