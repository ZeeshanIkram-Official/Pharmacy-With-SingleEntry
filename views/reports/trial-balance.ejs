<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trial Balance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f5f7; font-size: 14px; }
    .main { margin-left: 220px; }
    .topbar { position: sticky; top: 0; z-index: 50; }
    .section-head td { background: #eef1f5; font-weight: 700; text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.6px; color: #495057; }
    .grand-total td { background: #212529; color: #fff; font-weight: 700; }
    .balanced-ok { color: #1e7e34; font-weight: 700; }
    .balanced-bad { color: #c0392b; font-weight: 700; }
    .print-only { display: none; }
    @media(max-width:768px){ .main{ margin-left:60px; } }
    @media print {
      .no-print { display: none !important; }
      .sidebar { display: none !important; }
      .main { margin-left: 0 !important; }
      body { font-size: 11px; }
      .print-only { display: block; }
    }
  </style>
</head>
<body>

<%- include('../partials/sidebar') %>

<main class="main">

  <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm no-print">
    <h2 class="fs-6 fw-semibold mb-0">📒 Trial Balance</h2>
    <div class="d-flex gap-2 align-items-center">
      <a href="/reports/journal-voucher" class="btn btn-outline-secondary btn-sm">➕ Journal Voucher</a>
    </div>
  </div>

  <div class="p-4">

    <div class="print-only mb-3">
      <h4 class="fw-bold mb-0">📒 Trial Balance</h4>
      <div class="text-muted small">As of <%= moment(asOf).format('DD MMM YYYY') %></div>
    </div>

    <!-- Date Filter -->
    <form method="GET" class="d-flex align-items-center gap-2 mb-4 p-3 bg-white border rounded shadow-sm flex-wrap no-print">
      <span class="small fw-semibold text-muted">As of Date</span>
      <input type="date" name="asOf" class="form-control form-control-sm" style="width:170px;" value="<%= asOf %>">
      <button class="btn btn-primary btn-sm">Apply</button>
      <a href="/reports/trial-balance" class="btn btn-outline-secondary btn-sm">Today</a>
    </form>

    <% const isBalanced = Math.abs(totalDr - totalCr) < 0.5; %>
    <div class="alert <%= isBalanced ? 'alert-success' : 'alert-danger' %> d-flex justify-content-between align-items-center py-2 px-3 mb-4 no-print">
      <span><%= isBalanced ? '✅ Trial Balance match kar rahi hai — Dr = Cr' : '⚠️ Trial Balance match nahi ho rahi, ledger check karo' %></span>
      <span class="fw-semibold">Dr Rs <%= totalDr.toLocaleString('en-PK', {maximumFractionDigits: 2}) %> &nbsp;|&nbsp; Cr Rs <%= totalCr.toLocaleString('en-PK', {maximumFractionDigits: 2}) %></span>
    </div>

    <div class="card shadow-sm">
      <div class="card-header bg-light d-flex align-items-center justify-content-between py-3">
        <h6 class="mb-0 fw-semibold">Chart of Accounts — Balances as of <%= moment(asOf).format('DD MMM YYYY') %></h6>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th class="text-uppercase small text-muted fw-semibold px-3" style="width:90px;">Code</th>
              <th class="text-uppercase small text-muted fw-semibold">Account</th>
              <th class="text-uppercase small text-muted fw-semibold text-end px-3">Debit (Rs)</th>
              <th class="text-uppercase small text-muted fw-semibold text-end px-3">Credit (Rs)</th>
            </tr>
          </thead>
          <tbody>
            <% let anyRows = false; %>
            <% ['asset','liability','equity','income','expense'].forEach(type => { %>
              <% const rows = sections[type]; %>
              <% if (rows.length > 0) { anyRows = true; %>
                <tr class="section-head">
                  <td colspan="4" class="px-3 py-2"><%= sectionLabels[type] %></td>
                </tr>
                <% rows.forEach(r => { %>
                  <tr>
                    <td class="px-3 text-muted"><%= r.code %></td>
                    <td><%= r.name %></td>
                    <td class="text-end px-3"><%= r.dr > 0 ? r.dr.toLocaleString('en-PK', {maximumFractionDigits: 2}) : '' %></td>
                    <td class="text-end px-3"><%= r.cr > 0 ? r.cr.toLocaleString('en-PK', {maximumFractionDigits: 2}) : '' %></td>
                  </tr>
                <% }) %>
              <% } %>
            <% }) %>
            <% if (!anyRows) { %>
              <tr><td colspan="4" class="text-center text-muted py-5">Is date tak koi ledger balance nahi hai</td></tr>
            <% } %>
          </tbody>
          <% if (anyRows) { %>
          <tfoot>
            <tr class="grand-total">
              <td colspan="2" class="px-3">TOTAL</td>
              <td class="text-end px-3">Rs <%= totalDr.toLocaleString('en-PK', {maximumFractionDigits: 2}) %></td>
              <td class="text-end px-3">Rs <%= totalCr.toLocaleString('en-PK', {maximumFractionDigits: 2}) %></td>
            </tr>
          </tfoot>
          <% } %>
        </table>
      </div>
    </div>

  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
