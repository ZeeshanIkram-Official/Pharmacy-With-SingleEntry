<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Walk-in Return</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f5f7; font-size: 14px; }
    .main { margin-left: 220px; }
    .topbar { position: sticky; top: 0; z-index: 50; }
    .search-results { position:absolute; z-index:20; width:100%; max-height:260px; overflow-y:auto; background:#fff; border:1px solid #dee2e6; border-top:none; display:none; }
    .search-results .item { padding:8px 12px; cursor:pointer; }
    .search-results .item:hover { background:#f1f3f5; }
    @media(max-width:768px){ .main{ margin-left:60px; } }
  </style>
</head>
<body>

<%- include('../partials/sidebar') %>

<main class="main">

  <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm">
    <h2 class="fs-6 fw-semibold mb-0">↩️ Walk-in Return — Bina Invoice</h2>
    <a href="/sale-returns" class="btn btn-outline-secondary btn-sm">← Back</a>
  </div>

  <div class="p-4">

    <div class="alert alert-warning border-start border-warning border-4 small">
      ⚠️ Ye return kisi original invoice se linked nahi hogi. Fraud-control ke liye is qisam ki returns "Open"
      category mein report hoti hain aur refund sirf <strong>Wallet/Store Credit</strong> mein add karna recommended hai.
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="row g-4">
      <div class="col-lg-5">
        <div class="card shadow-sm">
          <div class="card-header bg-light py-2"><h6 class="mb-0 fw-semibold">Customer & Refund</h6></div>
          <div class="card-body p-3">
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Customer (optional)</label>
              <select id="customerSelect" class="form-select form-select-sm">
                <option value="">Walk-in Customer</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c._id %>" data-name="<%= c.name %>"><%= c.name %> — <%= c.phone %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Refund Mode</label>
              <select id="refundMode" class="form-select form-select-sm">
                <option value="wallet" selected>Store Credit / Wallet (recommended)</option>
                <option value="cash">Cash</option>
                <option value="adjust">Adjust (no payout)</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Notes</label>
              <textarea id="notesInput" class="form-control form-control-sm" rows="2" placeholder="e.g. Customer invoice bhool aaya"></textarea>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="card shadow-sm">
          <div class="card-header bg-light py-2"><h6 class="mb-0 fw-semibold">Medicines Return Karni Hain</h6></div>
          <div class="card-body p-3">
            <div class="position-relative mb-3">
              <input type="text" id="medSearch" class="form-control" placeholder="Medicine ka naam ya barcode search karein..." autocomplete="off">
              <div id="searchResults" class="search-results"></div>
            </div>

            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Medicine</th>
                  <th style="width:80px;">Qty</th>
                  <th style="width:110px;">Rate</th>
                  <th style="width:110px;">Refund</th>
                  <th style="width:40px;"></th>
                </tr>
              </thead>
              <tbody id="cartBody">
                <tr id="emptyRow"><td colspan="5" class="text-center text-muted py-3">Koi item add nahi hui</td></tr>
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3" class="text-end fw-bold">Total Refund</td>
                  <td class="fw-bold text-danger" id="grandTotal">Rs. 0</td>
                  <td></td>
                </tr>
              </tfoot>
            </table>

            <button class="btn btn-danger w-100 mt-2" id="submitBtn" disabled>✅ Process Return</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<script>
let cart = [];

const searchInput = document.getElementById('medSearch');
const resultsBox = document.getElementById('searchResults');
let searchTimeout;

searchInput.addEventListener('input', () => {
  clearTimeout(searchTimeout);
  const q = searchInput.value.trim();
  if (q.length < 1) { resultsBox.style.display = 'none'; return; }
  searchTimeout = setTimeout(async () => {
    const res = await fetch(`/products/api/search?q=${encodeURIComponent(q)}`);
    const meds = await res.json();
    if (meds.length === 0) {
      resultsBox.innerHTML = '<div class="item text-muted">Koi medicine nahi mili</div>';
    } else {
      resultsBox.innerHTML = meds.map(m => `
        <div class="item" onclick='addToCart(${JSON.stringify(m).replace(/'/g, "&apos;")})'>
          <strong>${m.name}</strong> <span class="text-muted small">— Rs. ${m.sellingPrice}/unit</span>
        </div>
      `).join('');
    }
    resultsBox.style.display = 'block';
  }, 250);
});

document.addEventListener('click', (e) => {
  if (!resultsBox.contains(e.target) && e.target !== searchInput) resultsBox.style.display = 'none';
});

function addToCart(med) {
  if (cart.find(c => c.medicineId === med._id)) return;
  cart.push({
    medicineId: med._id,
    name: med.name,
    quantity: 1,
    unitPrice: med.sellingPrice || 0,
    reason: ''
  });
  searchInput.value = '';
  resultsBox.style.display = 'none';
  renderCart();
}

function removeFromCart(id) {
  cart = cart.filter(c => c.medicineId !== id);
  renderCart();
}

function updateItem(id, field, value) {
  const item = cart.find(c => c.medicineId === id);
  if (!item) return;
  item[field] = value;
  renderCart();
}

function renderCart() {
  const tbody = document.getElementById('cartBody');
  if (cart.length === 0) {
    tbody.innerHTML = '<tr id="emptyRow"><td colspan="5" class="text-center text-muted py-3">Koi item add nahi hui</td></tr>';
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('grandTotal').textContent = 'Rs. 0';
    return;
  }

  let total = 0;
  tbody.innerHTML = cart.map(item => {
    const refund = (parseFloat(item.quantity) || 0) * (parseFloat(item.unitPrice) || 0);
    total += refund;
    return `
      <tr>
        <td>${item.name}</td>
        <td><input type="number" min="1" value="${item.quantity}" class="form-control form-control-sm" onchange="updateItem('${item.medicineId}','quantity',this.value)"></td>
        <td><input type="number" min="0" step="0.01" value="${item.unitPrice}" class="form-control form-control-sm" onchange="updateItem('${item.medicineId}','unitPrice',this.value)"></td>
        <td>Rs. ${refund.toLocaleString()}</td>
        <td><button class="btn btn-sm btn-outline-danger" onclick="removeFromCart('${item.medicineId}')">✕</button></td>
      </tr>
    `;
  }).join('');

  document.getElementById('grandTotal').textContent = `Rs. ${total.toLocaleString()}`;
  document.getElementById('submitBtn').disabled = false;
}

document.getElementById('submitBtn').addEventListener('click', async () => {
  const customerId = document.getElementById('customerSelect').value;
  const customerOpt = document.getElementById('customerSelect').selectedOptions[0];
  const customerName = customerId ? customerOpt.dataset.name : 'Walk-in Customer';
  const refundMode = document.getElementById('refundMode').value;
  const notes = document.getElementById('notesInput').value;

  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.textContent = 'Processing...';

  try {
    const res = await fetch('/sale-returns/open', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ customerId, customerName, items: JSON.stringify(cart), refundMode, notes })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Kuch ghalat ho gaya');
    alert(`✅ Return successful — ${data.returnNumber} — Rs. ${data.totalRefund.toLocaleString()} refund`);
    window.location.href = '/sale-returns';
  } catch (err) {
    alert('❌ ' + err.message);
    btn.disabled = false;
    btn.textContent = '✅ Process Return';
  }
});
</script>

</body>
</html>
