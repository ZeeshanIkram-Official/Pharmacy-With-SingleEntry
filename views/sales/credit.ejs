<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Credit / Advance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f5f7; font-size: 14px; }
    .main { margin-left: 220px; }
    .topbar { position: sticky; top: 0; z-index: 50; }
    .invoice-num { color: #d68910; font-weight: 700; font-size: 13px; }
    .view-btn.active { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .wallet-badge { background: #d1fae5; color: #065f46; font-size: 12px; font-weight: 700; border-radius: 8px; padding: 3px 10px; }
    @media(max-width:768px){ .main{ margin-left:60px; } }
  </style>
</head>
<body>

<%- include('../partials/sidebar') %>

<main class="main">

  <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm">
    <h2 class="fs-6 fw-semibold mb-0">
      <% if (activeView === 'advance') { %>
        💰 Advance Accounts (Debt)
      <% } else { %>
        💳 Credit Sales
      <% } %>
    </h2>
    <div class="d-flex gap-2">
      <a href="/sales/credit/voucher" class="btn btn-outline-warning btn-sm" style="border-color:#d68910; color:#d68910;">🧾 Credit Voucher</a>
      <a href="/sales/new" class="btn btn-primary btn-sm">+ New Sale</a>
    </div>
  </div>

  <div class="p-4">

    <%# ── VIEW TOGGLE DROPDOWN ── %>
    <div class="d-flex align-items-center gap-3 mb-4">
      <div class="btn-group" role="group">
        <a href="/sales/credit?view=credit<%= date ? '&date='+date : '' %><%= search ? '&search='+search : '' %>"
           class="btn btn-outline-danger btn-sm view-btn <%= activeView !== 'advance' ? 'active' : '' %>">
          💳 Credit Sales
        </a>
        <a href="/sales/credit?view=advance<%= search ? '&search='+search : '' %>"
           class="btn btn-outline-success btn-sm view-btn <%= activeView === 'advance' ? 'active' : '' %>">
          💰 Advance (Debt)
        </a>
      </div>
    </div>

    <%# ── SUMMARY CARDS ── %>
    <div class="d-flex gap-3 mb-4">
      <% if (activeView !== 'advance') { %>
      <div class="card shadow-sm px-4 py-3">
        <div class="small text-muted mb-1">Total Credit Sales</div>
        <div class="fs-4 fw-bold text-danger"><%= sales ? sales.length : 0 %></div>
      </div>
      <div class="card shadow-sm px-4 py-3">
        <div class="small text-muted mb-1">Total Outstanding</div>
        <div class="fs-4 fw-bold text-danger">
          Rs. <%= totalCredit ? totalCredit.toLocaleString() : 0 %>
        </div>
      </div>
      <% } else { %>
      <div class="card shadow-sm px-4 py-3">
        <div class="small text-muted mb-1">Customers with Advance</div>
        <div class="fs-4 fw-bold text-success"><%= advanceCustomers ? advanceCustomers.length : 0 %></div>
      </div>
      <div class="card shadow-sm px-4 py-3">
        <div class="small text-muted mb-1">Total Advance (Debt)</div>
        <div class="fs-4 fw-bold text-success">
          Rs. <%= totalAdvance ? totalAdvance.toLocaleString() : 0 %>
        </div>
      </div>
      <% } %>
    </div>

    <%# ── FILTER BAR ── %>
    <form class="d-flex gap-2 mb-3 align-items-center" method="GET">
      <input type="hidden" name="view" value="<%= activeView %>">
      <input type="text" name="search" class="form-control"
             placeholder="<%= activeView === 'advance' ? 'Search customer name...' : 'Search invoice...' %>"
             value="<%= search || '' %>">
      <% if (activeView !== 'advance') { %>
      <input type="date" name="date" class="form-control" style="width:180px;"
             value="<%= date || '' %>">
      <% } %>
      <button type="submit" class="btn btn-primary">Filter</button>
      <a href="/sales/credit?view=<%= activeView %>" class="btn btn-outline-secondary">Clear</a>
    </form>

    <%# ══════════════════════════════ %>
    <%# CREDIT SALES TABLE            %>
    <%# ══════════════════════════════ %>
    <% if (activeView !== 'advance') { %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
          <thead class="table-light">
            <tr>
              <th class="text-uppercase small text-muted fw-semibold px-3">Invoice</th>
              <th class="text-uppercase small text-muted fw-semibold">Date</th>
              <th class="text-uppercase small text-muted fw-semibold">Customer</th>
              <th class="text-uppercase small text-muted fw-semibold">Items</th>
              <th class="text-uppercase small text-muted fw-semibold">Total</th>
              <th class="text-uppercase small text-muted fw-semibold">Paid</th>
              <th class="text-uppercase small text-muted fw-semibold text-danger">Baaki</th>
              <th class="text-uppercase small text-muted fw-semibold">Status</th>
              <th class="text-uppercase small text-muted fw-semibold">Action</th>
            </tr>
          </thead>
          <tbody>
  <% if (!sales || sales.length === 0) { %>
    <tr><td colspan="9" class="text-center text-muted py-5">No credit sales found</td></tr>
  <% } %>
  <% sales.forEach(row => { %>
  <tr>
    <td class="invoice-num px-3">
      <%= row.latestSale.invoiceNumber %>
      <% if (row.invoiceCount > 1) { %>
        <div class="text-muted" style="font-size:10px"><%= row.invoiceCount %> invoices</div>
      <% } %>
    </td>
    <td>
      <%= moment(row.latestSale.createdAt).format('DD/MM/YY') %>
      <div class="text-muted small"><%= moment(row.latestSale.createdAt).format('hh:mm A') %></div>
    </td>
    <td><%= row.customerName %></td>
    <td class="text-muted small"><%= row.latestSale.items.length %> items</td>

    <td class="fw-bold">
      Rs. <%= row.totalAmount.toLocaleString() %>
      <% if (row.invoiceCount > 1) { %>
        <div class="text-muted" style="font-size:10px"><%= row.invoiceCount %> invoices ka total</div>
      <% } %>
    </td>

    <td class="text-success fw-semibold">
      Rs. <%= row.totalPaid.toLocaleString() %>
    </td>

    <td class="text-danger fw-bold">
      Rs. <%= row.totalBaaki.toLocaleString() %>
    </td>

    <td>
      <span class="badge bg-warning text-dark">pending</span>
    </td>

    <td>
      <a href="/sales/<%= row.latestSale._id %>/invoice"
         class="btn btn-outline-secondary btn-sm" target="_blank">
        🖨️ Invoice
      </a>
    </td>
  </tr>
  <% }) %>
</tbody>
        </table>
      </div>
    </div>
    <% } %>

    <%# ══════════════════════════════ %>
    <%# ADVANCE (DEBT) TABLE          %>
    <%# ══════════════════════════════ %>
    <% if (activeView === 'advance') { %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
          <thead class="table-light">
            <tr>
              <th class="text-uppercase small text-muted fw-semibold px-3">Customer</th>
              <th class="text-uppercase small text-muted fw-semibold">Phone</th>
              <th class="text-uppercase small text-muted fw-semibold">Total Purchases</th>
              <th class="text-uppercase small text-muted fw-semibold text-success">Advance Balance (Debt)</th>
              <th class="text-uppercase small text-muted fw-semibold">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (!advanceCustomers || advanceCustomers.length === 0) { %>
              <tr><td colspan="5" class="text-center text-muted py-5">Koi advance amount nahi mila</td></tr>
            <% } %>
            <% advanceCustomers.forEach(c => { %>
            <tr>
              <td class="fw-semibold px-3"><%= c.name %></td>
              <td class="text-muted"><%= c.phone || '—' %></td>
              <td class="text-muted"><%= c.totalPurchases || 0 %></td>
              <td>
                <span class="wallet-badge">Rs. <%= (c.walletBalance || 0).toLocaleString() %></span>
              </td>
              <td>
                <a href="/customers/<%= c._id %>" class="btn btn-outline-primary btn-sm">
                  👁 Detail
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

  </div>
</main>

</body>
</html>
