<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof editSale !== 'undefined' && editSale ? 'Edit Bill — ' + editSale.invoiceNumber : 'New Sale' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Only what Bootstrap cannot do */
    body { font-size: 14px; }
    .main { margin-left: 220px; }
    .pos-left  { display: flex; flex-direction: column; gap: 12px; overflow: hidden; height: calc(100vh - 76px); }
    .pos-right { display: flex; flex-direction: column; overflow: hidden; height: calc(100vh - 76px); }
    .product-search-results { display: none; grid-template-columns: repeat(3,1fr); gap: 8px; }
    .product-tile { cursor: pointer; transition: border-color .15s, background .15s; }
    .product-tile:hover { border-color: #0d6efd !important; background: #e7f1ff !important; }
    .cart-table { flex: 1; overflow-y: auto; }
    .cart-qty-controls button { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; }
    .cart-qty { width: 28px; text-align: center; }
    .disc-type-select { font-size: 0.72rem; padding: 2px 4px; width: auto !important; cursor: pointer; }
    #successModal { display: none; position: fixed; inset: 0; z-index: 1055; align-items: center; justify-content: center; }
    @media(max-width: 768px) { .main { margin-left: 60px; } }
  </style>
</head>
<body class="bg-light">
  <%- include('../partials/sidebar') %>

  <main class="main">

    <!-- Top Bar -->
    <div class="bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm sticky-top">
      <h2 class="fs-6 fw-semibold mb-0">Point of Sale</h2>
      <button class="btn btn-danger btn-sm" onclick="clearCart()">🗑 Clear Cart</button>
    </div>

    <!-- POS Layout -->
    <div class="d-grid gap-3 p-3" style="grid-template-columns: 1fr 360px;">

      <!-- LEFT PANEL -->
      <div class="pos-left">

        <!-- Search + Customer -->
        <div class="card shadow-sm">
          <div class="card-body py-3">
            <div class="input-group mb-2">
              <span class="input-group-text bg-white">🔍</span>
              <input type="text" id="productSearch"
                     class="form-control border-start-0"
                     placeholder="Search product by name or barcode..."
                     autofocus>
            </div>
            <div class="d-flex gap-2 align-items-center mt-2">
              <select id="customerId" class="form-select" onchange="toggleCreditOption()">
                <option value="">👤 Walk-in Customer</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c._id %>"
                          data-name="<%= c.name %>"
                          data-wallet="<%= c.walletBalance || 0 %>"
                          data-credit="<%= c.creditOwed || 0 %>">
                    <%= c.name %> (<%= c.phone || 'No phone' %>)
                    <% if ((c.walletBalance || 0) > 0) { %> — 💰 Advance: Rs. <%= c.walletBalance.toLocaleString() %><% } %>
                    <% if ((c.creditOwed || 0) > 0) { %> — 🔴 Credit: Rs. <%= c.creditOwed.toLocaleString() %><% } %>
                  </option>
                <% }) %>
              </select>
              <a href="/customers/add" class="btn btn-outline-secondary btn-sm text-nowrap" target="_blank">+ Add</a>
            </div>

            <!-- Wallet Balance Info Box -->
            <div id="walletInfoBox" class="mt-2 d-none">
              <div class="alert alert-success py-2 px-3 mb-0 d-flex align-items-center gap-2" style="font-size:13px;">
                <span>💰</span>
                <div>
                  <strong id="walletCustomerName"></strong> ka advance balance:
                  <strong class="text-success" id="walletAmount">Rs. 0</strong>
                  — yeh auto deduct hoga bill se
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Search Results -->
        <div id="searchResults" class="product-search-results"></div>

        <!-- Cart -->
        <div class="card shadow-sm flex-fill overflow-hidden d-flex flex-column">
          <div class="card-header bg-light d-flex align-items-center justify-content-between py-2">
            <h6 class="mb-0 fw-semibold">🛒 Cart Items</h6>
            <span class="badge bg-info-subtle text-info border border-info-subtle" id="itemCount">0 items</span>
          </div>
          <div class="cart-table" id="cartItems">
            <div class="text-center py-5 text-muted" id="cartEmpty">
              <div class="fs-2 mb-2 opacity-25">🛒</div>
              <p class="mb-0 small">Cart is empty — search and add products above</p>
            </div>
          </div>
        </div>

      </div><!-- /LEFT -->

      <!-- RIGHT PANEL -->
      <div class="pos-right card shadow-sm">
        <div class="card-header bg-light py-2">
          <h6 class="mb-0 fw-semibold">Bill Summary</h6>
        </div>
        <div class="p-3 flex-fill d-flex flex-column">

          <div class="d-flex justify-content-between mb-2 small">
            <span class="text-muted">Subtotal</span>
            <span id="subtotal" class="fw-semibold">Rs. 0</span>
          </div>

          <div class="d-flex align-items-center justify-content-between mb-2 small gap-2">
            <span class="text-muted d-flex align-items-center gap-1">
              Overall Discount
              <select id="overallDiscTypeBtn"
                      class="disc-type-select form-select form-select-sm border-primary text-primary fw-bold"
                      style="width:52px!important;"
                      onchange="changeOverallDiscountType(this.value)">
                <option value="percent">%</option>
                <option value="amount">Rs</option>
              </select>
            </span>
            <input type="number" id="discount"
                   class="form-control form-control-sm text-end"
                   style="width:90px;" placeholder="0" min="0" step="0.01"
                   oninput="calculateTotal()">
          </div>

          <!-- Total Row -->
          <div class="d-flex justify-content-between align-items-center rounded mb-2 px-3 py-3 bg-primary-subtle border border-primary-subtle">
            <strong class="small text-uppercase text-muted fw-bold" style="letter-spacing:.5px;">Total</strong>
            <span id="total" class="fs-5 fw-bold text-warning">Rs. 0</span>
          </div>

          <!-- Wallet Deduction Row -->
          <div id="walletDeductRow" class="d-none">
            <div class="d-flex justify-content-between mb-1 small">
              <span class="text-success fw-semibold">💰 Advance Balance (Auto)</span>
              <span id="walletDeductAmt" class="fw-bold text-success">− Rs. 0</span>
            </div>
            <div class="d-flex justify-content-between align-items-center rounded mb-2 px-3 py-2 bg-success-subtle border border-success-subtle">
              <strong class="small text-uppercase text-muted fw-bold" style="letter-spacing:.5px;">Baaki Amount</strong>
              <span id="netTotal" class="fs-5 fw-bold text-success">Rs. 0</span>
            </div>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-semibold text-muted mb-1">Payment Method</label>
            <select id="paymentMethod" class="form-select form-select-sm" onchange="toggleBankDropdown()">
              <option value="cash">Cash</option>
              
              <option value="bank">Bank Transfer</option>
              <option value="credit">Credit</option>
            </select>
          </div>

          <!-- Bank Account Dropdown — sirf tab dikhay jab 'bank' select ho -->
          <div class="mb-2" id="bankAccountRow" style="display:none;">
            <label class="form-label small fw-semibold text-muted mb-1">Bank Account Select Karein</label>
            <select id="bankAccountId" class="form-select form-select-sm">
              <option value="">— Select Bank —</option>
              <% if (typeof bankAccounts !== 'undefined') { %>
                <% bankAccounts.forEach(acc => { %>
                  <option value="<%= acc._id %>">
                    <%= acc.bankName %> — <%= acc.accountTitle %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <!-- Salesman Dropdown -->
          <div class="mb-2">
            <label class="form-label small fw-semibold text-muted mb-1">Salesman <span class="text-danger">*</span></label>
            <select id="salesmanId" class="form-select form-select-sm">
              <option value="">— Select Salesman —</option>
              <% if (typeof salesmen !== 'undefined') { salesmen.forEach(sm => { %>
                <option value="<%= sm._id %>"><%= sm.name %></option>
              <% }) } %>
            </select>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-semibold text-muted mb-1">Amount Paid (Rs.)</label>
            <input type="number" id="amountPaid"
                   class="form-control form-control-sm"
                   placeholder="0" oninput="calcChange()" min="0">
          </div>

          <button class="btn btn-success w-100 mt-auto fw-semibold" onclick="completeSale()" id="completeSaleBtn">
            ✅ Complete Sale
          </button>
        </div>
      </div><!-- /RIGHT -->

    </div><!-- /POS Layout -->
  </main>

  <!-- Success Modal -->
  <div id="successModal" class="bg-black bg-opacity-50">
    <div class="bg-white rounded-3 p-4 shadow text-center" style="max-width:380px;width:90%;">
      <div class="fs-1 mb-3">✅</div>
      <h2 class="h5 fw-bold mb-2">Sale Complete!</h2>
      <p id="modalInvoice" class="fw-bold text-warning mb-4"></p>
      <div class="d-flex gap-2 justify-content-center">
        <button class="btn btn-outline-secondary btn-sm" onclick="printInvoice()">🖨️ Print Invoice</button>
        <button class="btn btn-primary btn-sm" onclick="newSale()">➕ New Sale</button>
      </div>
    </div>
  </div>

<script>
  let cart = [];
  let lastSaleId = null;
  let searchTimeout;
  let overallDiscountType = 'percent';

  function toggleCreditOption() {
    const customerSelect = document.getElementById('customerId');
    const customerId = customerSelect.value;
    const paymentMethod = document.getElementById('paymentMethod');
    const creditOption = paymentMethod.querySelector('option[value="credit"]');
    if (customerId === '') {
      creditOption.style.display = 'none';
      if (paymentMethod.value === 'credit') paymentMethod.value = 'cash';
    } else {
      creditOption.style.display = '';
    }
    toggleBankDropdown();
    updateWalletDisplay();
  }

  function updateWalletDisplay() {
    const customerSelect = document.getElementById('customerId');
    const selectedOption = customerSelect.options[customerSelect.selectedIndex];
    const wallet = parseFloat(selectedOption?.dataset?.wallet || 0);
    const name   = selectedOption?.dataset?.name || '';

    const walletInfoBox   = document.getElementById('walletInfoBox');
    const walletDeductRow = document.getElementById('walletDeductRow');
    const walletAmountEl  = document.getElementById('walletAmount');
    const walletCustomerNameEl = document.getElementById('walletCustomerName');

    if (wallet > 0 && customerSelect.value !== '') {
      walletInfoBox.classList.remove('d-none');
      walletAmountEl.textContent = 'Rs. ' + wallet.toLocaleString();
      walletCustomerNameEl.textContent = name;
      walletDeductRow.classList.remove('d-none');
    } else {
      walletInfoBox.classList.add('d-none');
      walletDeductRow.classList.add('d-none');
    }
    calculateTotal();
  }

  function toggleBankDropdown() {
    const method = document.getElementById('paymentMethod').value;
    const bankRow = document.getElementById('bankAccountRow');
    if (bankRow) bankRow.style.display = (method === 'bank') ? 'block' : 'none';
  }

  function changeOverallDiscountType(val) {
    overallDiscountType = val;
    document.getElementById('discount').value = '';
    calculateTotal();
  }

  document.getElementById('productSearch').addEventListener('input', function () {
    clearTimeout(searchTimeout);
    const q = this.value.trim();
    if (q.length < 1) { document.getElementById('searchResults').style.display = 'none'; return; }
    searchTimeout = setTimeout(() => searchProducts(q), 300);
  });

  async function searchProducts(q) {
    const res = await fetch(`/products/api/search?q=${encodeURIComponent(q)}`);
    const products = await res.json();
    const container = document.getElementById('searchResults');
    if (products.length === 0) { container.style.display = 'none'; return; }
    container.style.display = 'grid';
    container.innerHTML = products.map(p => {
      const price      = p.sellingPrice || 0;
      const stock      = p.stockBoxes || 0;
      const safeName   = p.name.replace(/'/g,"\\'").replace(/"/g,'&quot;');
      const outOfStock = stock <= 0;
      const rx         = p.requiresPrescription ? 1 : 0;
      return `
        <div class="product-tile card border text-center p-2 ${outOfStock ? 'border-warning bg-warning-subtle' : ''}"
             onclick="openQtyPicker('${p._id}','${safeName}',${price},${stock},${rx})">
          <div class="fw-semibold small text-dark mb-1">
            ${p.name}
            ${rx ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1" style="font-size:9px;">Rx</span>' : ''}
          </div>
          <div class="fw-bold text-primary">Rs. ${price.toLocaleString()}</div>
          <div class="${outOfStock ? 'text-warning fw-semibold' : 'text-muted'}" style="font-size:.68rem;">
            ${outOfStock
              ? '⚠️ Out of Stock'
              : `🖊 ${Number(stock.toFixed(2))} available`}
          </div>
        </div>`;
    }).join('');
  }

  // ─── Quantity Picker (box ka koi concept nahi, seedha tablets/units) ──────
  let _qtyPicker = null;

  function openQtyPicker(id, name, price, stock, rx) {
    if (_qtyPicker) _qtyPicker.remove();
    const outOfStock = stock <= 0;

    const overlay = document.createElement('div');
    overlay.id = 'qtyPickerOverlay';
    overlay.style.cssText = 'position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;';
    overlay.innerHTML = `
      <div class="bg-white rounded-3 p-4 shadow" style="min-width:300px;max-width:360px;width:90%;">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h6 class="fw-bold mb-0">
            ${name}
            ${rx ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1" style="font-size:9px;">Rx</span>' : ''}
          </h6>
          <button class="btn-close" onclick="closeQtyPicker()"></button>
        </div>

        ${rx ? `
        <div class="alert alert-danger py-2 px-3 mb-3" style="font-size:12px;">
          💊 <strong>Rx Medicine</strong> — Prescription required, please verify with the customer
        </div>` : ''}

        ${outOfStock ? `
        <div class="alert alert-warning py-2 px-3 mb-3" style="font-size:12px;">
          ⚠️ <strong>Out of Stock</strong> — Stock 0 hai, phir bhi sale kr sakte hain (negative mein jayega)
        </div>` : ''}

        <div class="d-flex justify-content-between bg-light rounded px-3 py-2 mb-2">
          <span class="small text-muted">Unit Price</span>
          <span id="qtyPriceDisplay" class="fw-bold text-primary">Rs. ${price.toLocaleString()}</span>
        </div>
        <div class="d-flex justify-content-between small text-muted mb-3">
          <span>Available Stock</span>
          <span class="${outOfStock ? 'text-warning fw-semibold' : ''}">${outOfStock ? '⚠️ 0' : Number(stock.toFixed(2)) + ' units'}</span>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold text-muted mb-1">Quantity (Tablets/Units)</label>
          <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm px-3"
                    onclick="qtyStep(-1,${stock})">−</button>
            <input type="number" id="qtyInput"
                   class="form-control form-control-sm text-center fw-bold"
                   value="1" min="1" style="width:70px;"
                   oninput="qtyValidate(${stock});recalcQtyTotal(${price})">
            <button class="btn btn-outline-secondary btn-sm px-3"
                    onclick="qtyStep(1,${stock})">+</button>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center rounded px-3 py-2 bg-primary-subtle border border-primary-subtle mb-3">
          <span class="small fw-semibold text-muted">Total</span>
          <span id="qtyTotalDisplay" class="fw-bold text-warning">Rs. ${price.toLocaleString()}</span>
        </div>

        <button class="btn btn-success w-100 fw-semibold"
                onclick="confirmQtyAdd('${id}','${name}',${price},${stock},${rx ? 1 : 0})">
          ➕ Add to Cart
        </button>
      </div>`;

    overlay.addEventListener('click', e => { if (e.target === overlay) closeQtyPicker(); });
    document.body.appendChild(overlay);
    _qtyPicker = overlay;
    document.getElementById('qtyInput').focus();
  }

  function closeQtyPicker() { if (_qtyPicker) { _qtyPicker.remove(); _qtyPicker = null; } }

  // ── stock 0 ho to bhi + button kaam kare ──
  function qtyStep(delta, stock) {
    const input = document.getElementById('qtyInput');
    let val = Math.max(1, (parseInt(input.value) || 1) + delta);
    if (stock > 0 && val > stock) val = Math.floor(stock);
    input.value = val;
    recalcQtyTotal();
  }

  // ── stock 0 ho to validation skip karo ──
  function qtyValidate(stock) {
    const input  = document.getElementById('qtyInput');
    let val = parseInt(input.value) || 1;
    if (val < 1) val = 1;
    if (stock > 0 && val > stock) {
      val = Math.floor(stock);
      alert(`Max ${val} units available!`);
    }
    input.value = val;
    recalcQtyTotal();
  }

  function recalcQtyTotal() {
    const unitPrice = parseFloat(
      document.getElementById('qtyPriceDisplay').textContent.replace(/[Rs.\s,]/g,'')
    ) || 0;
    const qty = parseInt(document.getElementById('qtyInput').value) || 1;
    document.getElementById('qtyTotalDisplay').textContent =
      `Rs. ${(unitPrice * qty).toLocaleString(undefined,{maximumFractionDigits:2})}`;
  }

  // ── stock 0 ho to bhi cart mein add ho sake ──
  function confirmQtyAdd(id, name, price, stock, rx) {
    const qty = parseInt(document.getElementById('qtyInput').value) || 1;

    if (qty < 1) { alert('Quantity kam az kam 1 honi chahiye!'); return; }
    if (stock > 0 && qty > stock) {
      alert(`Max ${Math.floor(stock)} units available!`);
      return;
    }

    const cartKey  = id;
    const existing = cart.find(i => i.cartKey === cartKey);
    if (existing) {
      const newQty = existing.quantity + qty;
      if (stock > 0 && newQty > stock) {
        alert(`Max ${Math.floor(stock)} units ka limit hai!`);
        return;
      }
      existing.quantity = newQty;
    } else {
      cart.push({
        cartKey, productId: id, name, price, quantity: qty,
        stock: stock > 0 ? stock : 99999,  // out-of-stock par unlimited allow
        itemDiscount: 0, itemDiscountType: 'percent',
        rx: !!rx
      });
    }
    closeQtyPicker();
    document.getElementById('productSearch').value = '';
    document.getElementById('searchResults').style.display = 'none';
    renderCart();
  }

  function changeItemDiscountType(idx, val) { cart[idx].itemDiscountType = val; cart[idx].itemDiscount = 0; renderCart(); }

  function updateItemDiscount(idx, val) {
    const parsed = Math.max(parseFloat(val) || 0, 0);
    const item   = cart[idx];
    const gross  = item.price * item.quantity;
    item.itemDiscount = item.itemDiscountType === 'amount' ? Math.min(parsed, gross) : Math.min(parsed, 100);
    renderCart();
  }

  function getItemTotal(item) {
    const gross = item.price * item.quantity;
    return item.itemDiscountType === 'amount'
      ? Math.max(gross - item.itemDiscount, 0)
      : gross * (1 - (item.itemDiscount || 0) / 100);
  }

  function renderCart() {
    const container = document.getElementById('cartItems');
    document.getElementById('itemCount').textContent = `${cart.reduce((s,i) => s + i.quantity, 0)} items`;
    if (cart.length === 0) {
      container.innerHTML = `<div class="text-center py-5 text-muted"><div class="fs-2 mb-2 opacity-25">🛒</div><p class="mb-0 small">Cart is empty</p></div>`;
      calculateTotal(); return;
    }
    container.innerHTML = `
      <table class="table table-sm mb-0">
        <thead class="table-light">
          <tr>
            <th class="small text-muted fw-semibold">Medicine</th>
            <th class="small text-muted fw-semibold text-center">Qty</th>
            <th class="small text-muted fw-semibold">Discount</th>
            <th class="small text-muted fw-semibold text-end">Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          ${cart.map((item, idx) => `
            <tr>
              <td>
                <div class="fw-semibold small">
                  ${item.name}
                  ${item.rx ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1" style="font-size:9px;">Rx</span>' : ''}
                </div>
                <div class="text-muted" style="font-size:11px;">
                  Rs. ${item.price.toLocaleString(undefined,{maximumFractionDigits:2})} each
                </div>
              </td>
              <td class="text-center">
                <div class="cart-qty-controls d-flex align-items-center justify-content-center gap-1">
                  <button class="btn btn-sm btn-outline-secondary p-0" onclick="changeQty(${idx},-1)">−</button>
                  <span class="cart-qty fw-semibold">${item.quantity}</span>
                  <button class="btn btn-sm btn-outline-secondary p-0" onclick="changeQty(${idx},1)">+</button>
                </div>
              </td>
              <td>
                <div class="d-flex gap-1 align-items-center">
                  <input type="number" class="form-control form-control-sm text-end"
                    style="width:60px;" value="${item.itemDiscount || ''}"
                    placeholder="0" min="0" step="0.01"
                    onchange="updateItemDiscount(${idx}, this.value)">
                  <select class="disc-type-select" onchange="changeItemDiscountType(${idx}, this.value)">
                    <option value="percent" ${item.itemDiscountType === 'percent' ? 'selected' : ''}>%</option>
                    <option value="amount"  ${item.itemDiscountType === 'amount'  ? 'selected' : ''}>Rs</option>
                  </select>
                </div>
              </td>
              <td class="text-end fw-bold text-success small">
                Rs. ${getItemTotal(item).toLocaleString(undefined,{maximumFractionDigits:0})}
              </td>
              <td>
                <button class="btn btn-sm btn-link text-danger p-0" onclick="removeItem(${idx})">✕</button>
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>`;
    calculateTotal();
  }

  function changeQty(idx, delta) {
    cart[idx].quantity += delta;
    if (cart[idx].quantity <= 0) { cart.splice(idx, 1); }
    else if (cart[idx].stock > 0 && cart[idx].quantity > cart[idx].stock) {
      cart[idx].quantity = cart[idx].stock;
      alert('Max stock reached!');
    }
    renderCart();
  }

  function removeItem(idx) { cart.splice(idx, 1); renderCart(); }
  function clearCart() { if (cart.length === 0) return; if (confirm('Clear entire cart?')) { cart = []; renderCart(); } }

  function calculateTotal() {
    let subtotal = 0;
    cart.forEach(item => { subtotal += getItemTotal(item); });
    const discountVal = parseFloat(document.getElementById('discount').value) || 0;
    const discountAmount = overallDiscountType === 'amount'
      ? Math.min(discountVal, subtotal)
      : (subtotal * Math.min(discountVal, 100)) / 100;
    const total = Math.floor(subtotal - discountAmount);
    document.getElementById('subtotal').textContent = `Rs. ${subtotal.toLocaleString()}`;
    document.getElementById('total').textContent    = `Rs. ${Math.max(0, total).toLocaleString()}`;

    // Wallet deduction display
    const customerSelect = document.getElementById('customerId');
    const selectedOption = customerSelect.options[customerSelect.selectedIndex];
    const wallet = parseFloat(selectedOption?.dataset?.wallet || 0);
    const walletUsed = Math.min(wallet, Math.max(0, total));
    const netTotal   = Math.max(0, total - walletUsed);

    const walletDeductAmtEl = document.getElementById('walletDeductAmt');
    const netTotalEl        = document.getElementById('netTotal');
    if (walletDeductAmtEl) walletDeductAmtEl.textContent = `− Rs. ${walletUsed.toLocaleString()}`;
    if (netTotalEl)        netTotalEl.textContent        = `Rs. ${netTotal.toLocaleString()}`;

    calcChange();
  }

  function calcChange() {
    const total = parseFloat(document.getElementById('total').textContent.replace(/[^0-9.]/g,'')) || 0;
    const paid  = parseFloat(document.getElementById('amountPaid').value) || 0;
    const changeEl = document.getElementById('change');
    if (changeEl) {
      const change = Math.floor(paid - total);
      changeEl.textContent = `Rs. ${Math.max(0, change).toLocaleString()}`;
      changeEl.className = change < 0 ? 'text-danger fw-bold' : 'text-success fw-bold';
    }
  }

  async function completeSale() {
    if (cart.length === 0) { alert('Please add items to cart!'); return; }
    const paymentMethod = document.getElementById('paymentMethod').value.toLowerCase();
    const amountPaid    = parseFloat(document.getElementById('amountPaid').value) || 0;
    if (paymentMethod !== 'credit' && amountPaid <= 0) { alert('Please enter amount paid!'); return; }
    if (paymentMethod === 'bank') {
      const bankId = document.getElementById('bankAccountId')?.value;
      if (!bankId) { alert('Bank account select karein!'); return; }
    }

    const salesmanId = document.getElementById('salesmanId').value;
    if (!salesmanId) { alert('Salesman select karna zaruri hai!'); document.getElementById('salesmanId').focus(); return; }

    const customerSelect = document.getElementById('customerId');
    const customerName   = customerSelect.options[customerSelect.selectedIndex].dataset.name || 'Walk-in Customer';
    const itemsForBackend = cart.map(item => ({
      productId: item.productId, name: item.name, price: item.price, quantity: item.quantity,
      itemDiscount: item.itemDiscount || 0, itemDiscountType: item.itemDiscountType || 'percent'
    }));
    const payload = {
      customerId: customerSelect.value, customerName,
      items: JSON.stringify(itemsForBackend),
      discount: document.getElementById('discount').value || 0,
      discountType: overallDiscountType, tax: 0, amountPaid, paymentMethod,
      bankAccountId: paymentMethod === 'bank' ? (document.getElementById('bankAccountId')?.value || '') : '',
      salesmanId
    };
    try {
      const res  = await fetch('/sales', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      const data = await res.json();
      if (data.success) {
        lastSaleId = data.saleId;
        let modalMsg = `Invoice: ${data.invoiceNumber}`;
        if (data.walletUsed > 0) modalMsg += `\n💰 Wallet used: Rs. ${data.walletUsed.toLocaleString()}`;
        if (data.advanceAdded > 0) modalMsg += `\n✅ Advance added: Rs. ${data.advanceAdded.toLocaleString()}`;
        document.getElementById('modalInvoice').textContent = modalMsg;
        document.getElementById('successModal').style.display = 'flex';
      } else { alert('Error: ' + (data.error || 'Something went wrong')); }
    } catch (err) { alert('Error completing sale.'); console.error(err); }
  }

  function printInvoice() { if (lastSaleId) window.open(`/sales/${lastSaleId}/invoice`, '_blank'); }

  function newSale() {
    cart = []; overallDiscountType = 'percent';
    document.getElementById('overallDiscTypeBtn').value = 'percent';
    renderCart();
    document.getElementById('discount').value = 0;
    document.getElementById('amountPaid').value = '';
    document.getElementById('customerId').value = '';
    document.getElementById('salesmanId').value = '';
    document.getElementById('successModal').style.display = 'none';
    document.getElementById('walletInfoBox').classList.add('d-none');
    document.getElementById('walletDeductRow').classList.add('d-none');
    document.getElementById('productSearch').focus();
    calculateTotal(); toggleCreditOption();
  }

  // ── Edit Mode: Pre-fill cart & form ──────────────────────────────────────
  <% if (typeof editSale !== 'undefined' && editSale) { %>
  const _editSale = <%- JSON.stringify({
    _id:           editSale._id,
    invoiceNumber: editSale.invoiceNumber,
    customerId:    editSale.customer ? editSale.customer._id : '',
    paymentMethod: editSale.paymentMethod,
    discountAmount: editSale.discountAmount,
    discountPercent: editSale.discountPercent,
    amountPaid:    editSale.amountPaid,
    salesmanId:    editSale.salesman,
    items: editSale.items.map(function(i){ return {
      productId: i.product,
      name:      i.productName,
      price:     i.unitPrice,
      quantity:  i.quantity,
      stock:     9999,
      itemDiscount: i.discountPercent || 0,
      itemDiscountType: 'percent',
      cartKey:   String(i.product)
    }; })
  }) %>;

  document.querySelector('h5.fw-bold') && (document.querySelector('h5.fw-bold').textContent = 'Edit Bill — ' + _editSale.invoiceNumber);
  document.getElementById('completeSaleBtn').textContent = '💾 Update Bill';

  cart = _editSale.items;

  if (_editSale.customerId) {
    const cSel = document.getElementById('customerId');
    for (let o of cSel.options) { if (o.value === String(_editSale.customerId)) { o.selected = true; break; } }
  }

  const pmSel = document.getElementById('paymentMethod');
  for (let o of pmSel.options) { if (o.value === _editSale.paymentMethod) { o.selected = true; break; } }

  if (_editSale.discountAmount > 0) {
    overallDiscountType = 'amount';
    document.getElementById('discount').value = _editSale.discountAmount;
  } else if (_editSale.discountPercent > 0) {
    overallDiscountType = 'percent';
    document.getElementById('discount').value = _editSale.discountPercent;
  }

  document.getElementById('amountPaid').value = _editSale.amountPaid || '';

  if (_editSale.salesmanId) {
    const sSel = document.getElementById('salesmanId');
    for (let o of sSel.options) { if (o.value === String(_editSale.salesmanId)) { o.selected = true; break; } }
  }

  const _editId = _editSale._id;
  completeSale = async function() {
    if (cart.length === 0) { alert('Cart khali hai!'); return; }
    const paymentMethod = document.getElementById('paymentMethod').value.toLowerCase();
    const amountPaid    = parseFloat(document.getElementById('amountPaid').value) || 0;
    const salesmanId    = document.getElementById('salesmanId').value;
    if (!salesmanId) { alert('Salesman select karein!'); return; }

    const customerSelect = document.getElementById('customerId');
    const itemsForBackend = cart.map(item => ({
      productId: item.productId, name: item.name, price: item.price,
      quantity: item.quantity,
      itemDiscount: item.itemDiscount || 0, itemDiscountType: item.itemDiscountType || 'percent'
    }));
    const payload = {
      customerId: customerSelect.value,
      items: JSON.stringify(itemsForBackend),
      discount: document.getElementById('discount').value || 0,
      discountType: overallDiscountType, tax: 0, amountPaid, paymentMethod,
      bankAccountId: paymentMethod === 'bank' ? (document.getElementById('bankAccountId')?.value || '') : '',
      salesmanId
    };
    try {
      const res  = await fetch(`/sales/${_editId}/edit`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      const data = await res.json();
      if (data.success) {
        window.location.href = `/sales/${_editId}/invoice`;
      } else { alert('Error: ' + (data.error || 'Something went wrong')); }
    } catch (err) { alert('Bill update mein error.'); console.error(err); }
  };
  <% } %>

  renderCart(); toggleCreditOption();

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeUomPicker();
  });
</script>
