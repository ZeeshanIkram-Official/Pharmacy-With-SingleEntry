<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Salesmen</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #f4f5f7;
      font-size: 14px;
    }

    .main {
      margin-left: 220px;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .stat-pill {
      font-size: 0.75rem;
      font-weight: 600;
    }

    @media(max-width:768px) {
      .main {
        margin-left: 60px;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/sidebar') %>

    <main class="main">

      <!-- Top Bar -->
      <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm">
        <h2 class="fs-6 fw-semibold mb-0">🧑‍💼 Salesmen</h2>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">
          + Add Salesman
        </button>
      </div>

      <div class="p-4">

        <!-- Flash Messages -->
        <% if (success && success.length) { %>
          <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <%= success %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
          <% } %>
            <% if (error && error.length) { %>
              <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
                <%= error %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
              <% } %>

                <!-- Salesmen Table -->
                <div class="card shadow-sm">
                  <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                    <span class="fw-semibold">All Salesmen</span>
                    <span class="badge bg-secondary">
                      <%= salesmen.length %> total
                    </span>
                  </div>
                  <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                      <thead class="table-light">
                        <tr>
                          <th class="text-uppercase small text-muted fw-semibold px-3">#</th>
                          <th class="text-uppercase small text-muted fw-semibold">Name</th>
                          <th class="text-uppercase small text-muted fw-semibold">Phone</th>
                          <th class="text-uppercase small text-muted fw-semibold text-center">Total Sales</th>
                          <th class="text-uppercase small text-muted fw-semibold text-end">Total Amount</th>
                          <th class="text-uppercase small text-muted fw-semibold text-center">Status</th>
                          <th class="text-uppercase small text-muted fw-semibold text-center">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (salesmen.length===0) { %>
                          <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                              <div class="fs-3 opacity-25 mb-2">🧑‍💼</div>
                              Abhi koi salesman nahi hai — Add Salesman button se add karein
                            </td>
                          </tr>
                          <% } %>
                            <% salesmen.forEach((sm, i)=> { %>
                              <tr>
                                <td class="px-3 text-muted">
                                  <%= i + 1 %>
                                </td>
                                <td class="fw-semibold">
                                  <a href="/salesmen/<%= sm._id %>/sales" class="text-decoration-none text-dark">
                                    <%= sm.name %>
                                  </a>
                                </td>
                                <td class="text-muted">
                                  <%= sm.phone || '—' %>
                                </td>
                                <td class="text-center">
                                  <span class="badge bg-info-subtle text-info border border-info-subtle stat-pill">
                                    <%= sm.stats.totalSales %> sales
                                  </span>
                                </td>
                                <td class="text-end fw-semibold">
                                  Rs. <%= sm.stats.totalAmount.toLocaleString() %>
                                </td>
                                <td class="text-center">
                                  <% if (sm.isActive) { %>
                                    <span
                                      class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    <% } else { %>
                                      <span
                                        class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                      <% } %>
                                </td>
                                <td class="text-center">
                                  <div class="d-flex gap-1 justify-content-center">
                                    <a href="/salesmen/<%= sm._id %>/sales"
                                      class="btn btn-outline-primary btn-sm py-0 px-2">
                                      Sales
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2"
                                      data-bs-toggle="modal" data-bs-target="#editModal<%= sm._id %>">
                                      ✏️ Edit
                                    </button>
                                    <form action="/salesmen/<%= sm._id %>/toggle" method="POST" style="display:inline;">
                                      <button type="submit"
                                        class="btn btn-sm py-0 px-2 <%= sm.isActive ? 'btn-outline-warning' : 'btn-outline-success' %>"
                                        onclick="return confirm('<%= sm.isActive ? 'Inactive' : 'Active' %> kar dein?')">
                                        <%= sm.isActive ? 'Deactivate' : 'Activate' %>
                                      </button>
                                    </form>
                                  </div>
                                </td>
                              </tr>

                              <!-- Edit Modal -->
                              <div class="modal fade" id="editModal<%= sm._id %>" tabindex="-1">
                                <div class="modal-dialog modal-sm">
                                  <div class="modal-content">
                                    <div class="modal-header py-2">
                                      <h6 class="modal-title fw-semibold">Edit Salesman</h6>
                                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form action="/salesmen/<%= sm._id %>?_method=PUT" method="POST">
                                      <div class="modal-body">
                                        <div class="mb-3">
                                          <label class="form-label fw-semibold small">Name <span class="text-danger">*</span></label>
                                          <input type="text" name="name" class="form-control" value="<%= sm.name %>" required>
                                        </div>
                                        <div class="mb-1">
                                          <label class="form-label fw-semibold small">Phone</label>
                                          <input type="text" name="phone" class="form-control" value="<%= sm.phone || '' %>">
                                        </div>
                                      </div>
                                      <div class="modal-footer py-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary btn-sm">💾 Save</button>
                                      </div>
                                    </form>
                                  </div>
                                </div>
                              </div>
                              <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>

      </div>
    </main>

    <!-- Add Salesman Modal -->
    <div class="modal fade" id="addModal" tabindex="-1">
      <div class="modal-dialog modal-sm">
        <div class="modal-content">
          <div class="modal-header py-2">
            <h6 class="modal-title fw-semibold">Add New Salesman</h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <form action="/salesmen" method="POST">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label fw-semibold small">Name <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" placeholder="e.g. Ali Raza" required autofocus>
              </div>
              <div class="mb-1">
                <label class="form-label fw-semibold small">Phone</label>
                <input type="text" name="phone" class="form-control" placeholder="e.g. 03xx-xxxxxxx">
              </div>
            </div>
            <div class="modal-footer py-2">
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Add Salesman</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>