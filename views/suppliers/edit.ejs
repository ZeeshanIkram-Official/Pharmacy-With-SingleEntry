<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Supplier</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>✏️ Edit Supplier</h2>
    <a href="/suppliers" class="btn btn-secondary">Back</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <div class="card shadow-sm p-4">

    <form action="/suppliers/edit/<%= supplier._id %>" method="POST">

      <!-- BASIC INFO -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label>Name *</label>
          <input type="text" name="name" value="<%= supplier.name %>" class="form-control" required>
        </div>

        <div class="col-md-6 mb-3">
          <label>Company</label>
          <input type="text" name="company" value="<%= supplier.company %>" class="form-control">
        </div>
      </div>

      <!-- CONTACT -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label>Phone</label>
          <input type="text" name="phone" value="<%= supplier.phone %>" class="form-control">
        </div>

        <div class="col-md-6 mb-3">
          <label>WhatsApp</label>
          <input type="text" name="whatsapp" value="<%= supplier.whatsapp %>" class="form-control">
        </div>
      </div>

      <div class="mb-3">
        <label>Email</label>
        <input type="email" name="email" value="<%= supplier.email %>" class="form-control">
      </div>

      <div class="mb-3">
        <label>Address</label>
        <textarea name="address" class="form-control"><%= supplier.address %></textarea>
      </div>

      <!-- BUSINESS -->
      <div class="row">
        <div class="col-md-4 mb-3">
          <label>Credit Limit</label>
          <input type="number" name="creditLimit" value="<%= supplier.creditLimit %>" class="form-control">
        </div>
      </div>

      <!-- Total Purchases / Total Paid ab yahan se manually edit nahi hote —
           yeh Purchase Ledger (har purchase ki alag entry) se automatically
           calculate hote hain. Naya purchase add karne ya payment karne ke
           liye supplier ki Ledger/Detail page use karo. -->
      <div class="alert alert-info py-2 px-3 mb-3" style="font-size:13px;">
        📒 Total Purchases: <strong>Rs. <%= (supplier.totalPurchases || 0).toLocaleString() %></strong>
        &nbsp;|&nbsp; Total Paid: <strong>Rs. <%= (supplier.totalPaid || 0).toLocaleString() %></strong>
        &nbsp;|&nbsp; Remaining: <strong>Rs. <%= (supplier.balance || 0).toLocaleString() %></strong>
        <br>
        <a href="/suppliers/<%= supplier._id %>">Naya purchase add karne ya payment karne ke liye Ledger page kholein →</a>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label>Payment Terms</label>
          <select name="paymentTerms" class="form-control">
            <option value="cash" <%= supplier.paymentTerms === 'cash' ? 'selected' : '' %>>Cash</option>
            <option value="credit" <%= supplier.paymentTerms === 'credit' ? 'selected' : '' %>>Credit</option>
            <option value="net7" <%= supplier.paymentTerms === 'net7' ? 'selected' : '' %>>Net 7</option>
            <option value="net15" <%= supplier.paymentTerms === 'net15' ? 'selected' : '' %>>Net 15</option>
            <option value="net30" <%= supplier.paymentTerms === 'net30' ? 'selected' : '' %>>Net 30</option>
          </select>
        </div>
      </div>

      <!-- STATUS -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label>Status</label>
          <select name="status" class="form-control">
            <option value="active" <%= supplier.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= supplier.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            <option value="blocked" <%= supplier.status === 'blocked' ? 'selected' : '' %>>Blocked</option>
          </select>
        </div>

        <div class="col-md-6 mb-3 d-flex align-items-center mt-4">
          <input type="checkbox" name="isActive" class="form-check-input me-2"
            <%= supplier.isActive ? 'checked' : '' %>>
          <label>Active</label>
        </div>
      </div>

      <!-- NOTES -->
      <div class="mb-3">
        <label>Discription</label>
        <textarea name="notes" class="form-control"><%= supplier.notes %></textarea>
      </div>

      <button class="btn btn-primary w-100">Update Supplier</button>

    </form>

  </div>
</div>

</body>
</html>