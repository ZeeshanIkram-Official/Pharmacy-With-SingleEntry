<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Suppliers</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f4f5f7; font-size: 14px; }
    .main { margin-left: 220px; }
    .topbar { position: sticky; top: 0; z-index: 50; }
    .supplier-name { font-weight: 700; color: #d68910; }
    @media(max-width:768px){ .main{ margin-left:60px; } }
  </style>
</head>
<body>

<%- include('../partials/sidebar') %>

<main class="main">

  <%# Topbar %>
  <div class="topbar bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between shadow-sm">
    <h2 class="fs-6 fw-semibold mb-0">🏭 Suppliers</h2>
    <a href="/suppliers/add" class="btn btn-primary btn-sm">+ Add Supplier</a>
  </div>

  <div class="p-4">

    <%# Search %>
    <form class="d-flex gap-2 mb-3 align-items-center" method="GET" action="/suppliers">
      <div class="input-group flex-grow-1">
        <span class="input-group-text bg-white">🔍</span>
        <input type="text" name="search" class="form-control border-start-0"
               placeholder="Search supplier by name, company..."
               value="<%= search || '' %>">
      </div>
      <button type="submit" class="btn btn-primary">Search</button>
      <a href="/suppliers" class="btn btn-outline-secondary">Clear</a>
    </form>

    <%# Flash Messages %>
    <% if (typeof success !== 'undefined' && success.length > 0) { %>
      <div class="alert alert-success border-start border-success border-4">✅ <%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="alert alert-danger border-start border-danger border-4">⚠️ <%= error %></div>
    <% } %>

    <%# Table %>
    <div class="card shadow-sm">
      <div class="card-header bg-light d-flex align-items-center justify-content-between py-3">
        <h6 class="mb-0 fw-semibold">All Suppliers</h6>
        <span class="badge bg-light text-secondary border border-secondary-subtle px-3">
          <%= suppliers ? suppliers.length : 0 %> total
        </span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
          <thead class="table-light">
            <tr>
              <th class="text-uppercase small text-muted fw-semibold px-3">#</th>
              <th class="text-uppercase small text-muted fw-semibold">Name</th>
              <th class="text-uppercase small text-muted fw-semibold">Company</th>
              <th class="text-uppercase small text-muted fw-semibold">Phone</th>
              <th class="text-uppercase small text-muted fw-semibold">WhatsApp</th>
              <th class="text-uppercase small text-muted fw-semibold">Remaining</th>
              <th class="text-uppercase small text-muted fw-semibold">Status</th>
              <th class="text-uppercase small text-muted fw-semibold">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!suppliers || suppliers.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-5">No suppliers found</td>
              </tr>
            <% } else { %>
              <% suppliers.forEach((supplier, i) => { %>
              <tr>
                <td class="text-muted small px-3"><%= i + 1 %></td>
                <td><a href="/suppliers/<%= supplier._id %>" class="supplier-name text-decoration-none"><%= supplier.name %></a></td>
                <td class="text-muted"><%= supplier.company || '—' %></td>
                <td><%= supplier.phone || '—' %></td>
                <td><%= supplier.whatsapp || '—' %></td>
                <td>
                  <span class="badge <%= supplier.balance >= 0 ? 'bg-success' : 'bg-danger' %>">
                    Rs. <%= (supplier.balance || 0).toLocaleString() %>
                  </span>
                </td>
                <td>
                  <% if (supplier.status === 'active') { %>
                    <span class="badge bg-success">Active</span>
                  <% } else if (supplier.status === 'blocked') { %>
                    <span class="badge bg-danger">Blocked</span>
                  <% } else { %>
                    <span class="badge bg-info text-dark">Inactive</span>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/suppliers/<%= supplier._id %>" class="btn btn-outline-primary btn-sm">📒 Ledger</a>
                    <a href="/suppliers/edit/<%= supplier._id %>" class="btn btn-outline-secondary btn-sm">✏️ Edit</a>
                    <a href="/suppliers/delete/<%= supplier._id %>"
                       class="btn btn-outline-danger btn-sm"
                       onclick="return confirm('Delete karna chahte ho?')">🗑</a>
                  </div>
                </td>
              </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>

</body>
</html>
