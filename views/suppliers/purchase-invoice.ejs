<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Purchase Invoice — Alhamd Pharmacy <%= purchase.invoiceNumber %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; background: #e8e8e5; }
    .font-serif { font-family: 'DM Serif Display', serif; }
    .stamp {
      display: inline-block; padding: 3px 10px; font-size: 9px; font-weight: 700;
      letter-spacing: 2px; text-transform: uppercase; transform: rotate(-2deg); border-radius: 2px;
    }
    .stamp-paid    { border: 2px solid #111; color: #111; }
    .stamp-pending { border: 2px solid #b8860b; color: #b8860b; }
    .topbar { position: sticky; top: 0; z-index: 100; }
    thead th { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #666; font-weight: 600; }
    .meta-lbl { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #666; }
    .meta-val { font-size: 13px; font-weight: 600; }
    .section-title { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; font-weight: 700; }
    .t-total { background: #111; color: #fff; }
    .t-remaining { background: #f0f5fd; border: 1px solid #c5d8f5; color: #1a4f8a; }
    .header-brand { display: flex; align-items: center; gap: 10px; }
    .brand-mark {
      width: 46px; height: 46px; flex-shrink: 0; border-radius: 10px; background: #111;
      color: #fff; display: flex; align-items: center; justify-content: center;
      font-size: 20px;
    }
    .sign-block { font-size: 11px; }
    .sign-line { border-bottom: 1px solid #333; height: 34px; }
    .sign-label { font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; color: #555; font-weight: 600; margin-top: 4px; }
    @media print {
      .topbar { display: none !important; }
      body { background: #fff; }
      .card { box-shadow: none !important; }
    }
  </style>
</head>
<body>

<!-- Top Bar -->
<div class="topbar bg-dark text-white py-2 px-3 d-flex justify-content-center gap-2">
  <button class="btn btn-sm btn-light fw-semibold" onclick="window.print()">🖨️ Print Invoice</button>
  <a href="/suppliers/<%= supplier ? supplier._id : '' %>" class="btn btn-sm btn-outline-secondary">← Back to Ledger</a>
</div>

<div class="container py-3" style="max-width:820px">
<div class="card border-0 shadow">

  <!-- Header -->
  <div class="row g-0 border-bottom border-2 border-dark">
    <div class="col-6 p-3 border-end">
      <div class="header-brand">
        <div class="brand-mark">💊</div>
        <div>
          <div class="font-serif fs-4 lh-1">Rashid Sagir Pharmacy</div>
          <div style="font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:#666" class="mt-1">Medicines &amp; Healthcare</div>
        </div>
      </div>
      <div class="text-muted mt-1" style="font-size:11px;line-height:1.6">21 Amir colony okara<br>0324-7575015 : 0321-5691007</div>
    </div>
    <div class="col-6 p-3 text-end">
      <div class="font-serif" style="font-size:32px;letter-spacing:-1px">Purchase</div>
      <div class="text-muted" style="font-size:12px;font-weight:500"><%= purchase.invoiceNumber %></div>
      <div class="text-muted" style="font-size:11px">
        <%= new Date(purchase.createdAt).toLocaleDateString('en-PK', { day:'numeric', month:'long', year:'numeric' }) %>
      </div>
      <%
        const remaining = Math.max(0, (purchase.amount || 0) - (purchase.amountPaid || 0));
      %>
      <div class="mt-1">
        <% if (purchase.status === 'completed' || remaining <= 0) { %>
          <span class="stamp stamp-paid">✓ Paid</span>
        <% } else { %>
          <span class="stamp stamp-pending">⏳ Pending</span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Meta Strip -->
  <div class="row g-0 bg-light border-bottom">
    <div class="col-4 p-2 px-3 border-end">
      <div class="meta-lbl">Purchased From</div>
      <div class="meta-val"><%= purchase.supplierName || (supplier ? supplier.name : '—') %></div>
    </div>
    <div class="col-4 p-2 px-3 border-end">
      <div class="meta-lbl">Supplier Phone</div>
      <div class="meta-val"><%= supplier && supplier.phone ? supplier.phone : '—' %></div>
    </div>
    <div class="col-4 p-2 px-3">
      <div class="meta-lbl">Note</div>
      <div class="meta-val" style="text-transform:none;"><%= purchase.note || '—' %></div>
    </div>
  </div>

  <!-- Items -->
  <div class="p-3">
    <% if (purchase.items && purchase.items.length > 0) { %>
    <table class="table table-sm mb-0">
      <thead>
        <tr>
          <th>Medicine</th>
          <th class="text-end">Qty (Tablets/Units)</th>
          <th class="text-end">Purchase Price / Unit</th>
          <th class="text-end">Line Total</th>
        </tr>
      </thead>
      <tbody>
        <% purchase.items.forEach(item => { %>
        <tr>
          <td class="fw-semibold"><%= item.medicineName %></td>
          <td class="text-end"><%= item.quantity %></td>
          <td class="text-end">Rs. <%= (item.unitPrice || 0).toLocaleString(undefined, {maximumFractionDigits:2}) %></td>
          <td class="text-end fw-bold">Rs. <%= (item.total || 0).toLocaleString(undefined, {maximumFractionDigits:2}) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
      <div class="text-muted text-center py-4" style="font-size:13px;">
        Is purchase mein itemized medicines record nahi hain (shayad ek purani/opening-balance entry hai).
      </div>
    <% } %>
  </div>

  <!-- Totals -->
  <div class="p-3 pt-0">
    <div class="row g-2 justify-content-end">
      <div class="col-5">
        <div class="d-flex justify-content-between align-items-center rounded px-3 py-2 t-total mb-2">
          <span class="section-title" style="color:#ccc;">Total Amount</span>
          <span class="fw-bold fs-6">Rs. <%= (purchase.amount || 0).toLocaleString(undefined, {maximumFractionDigits:2}) %></span>
        </div>
        <div class="d-flex justify-content-between px-3 py-1" style="font-size:13px;">
          <span class="text-muted">Amount Paid</span>
          <span class="fw-semibold" style="color:#166534;">Rs. <%= (purchase.amountPaid || 0).toLocaleString(undefined, {maximumFractionDigits:2}) %></span>
        </div>
        <% if (remaining > 0) { %>
        <div class="d-flex justify-content-between align-items-center rounded px-3 py-2 t-remaining mt-2">
          <span class="section-title" style="color:#1a4f8a;">Balance Remaining</span>
          <span class="fw-bold">Rs. <%= remaining.toLocaleString(undefined, {maximumFractionDigits:2}) %></span>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Signature -->
  <div class="row g-0 border-top p-3 sign-block">
    <div class="col-6">
      <div class="sign-line"></div>
      <div class="sign-label">Received By</div>
    </div>
    <div class="col-6 text-end">
      <div class="sign-line"></div>
      <div class="sign-label">Authorized Signature</div>
    </div>
  </div>

</div>
</div>

</body>
</html>
